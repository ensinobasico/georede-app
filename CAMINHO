  if (new URLSearchParams(location.search).get("geo") !== String(id)) history.pushState({ v: "aparelhos", g: id }, "", "/aparelhos?geo=" + id);
  const m = document.getElementById("aparelhos-msg"); if (m) m.hidden = true;
  desenharAparelhos(); atualizarTopo();
  document.getElementById("vista-aparelhos").scrollTop = 0;
}
function fecharGeo() {
  aConfirmar = null; aRenomear = null;
  if (history.state && history.state.g != null) { history.back(); return; }
  estado.geoAberto = null;
  history.replaceState({ v: "aparelhos" }, "", "/aparelhos");
  desenharAparelhos(); atualizarTopo();
}
function desenharGeo(a) {
  const c = document.getElementById("geo-ecra");
  c.replaceChildren();
  const el = (tag, cls, texto) => { const e = document.createElement(tag); if (cls) e.className = cls; if (texto != null) e.textContent = texto; return e; };
  // cabeçalho: figura, nome com lápis (muda ali mesmo), modelo e ID (o que está escrito na caixa)
  const cab = el("div", "geo-cab");
  const av = el("span", `geo-avatar grande ${frescura(vistoEm(a))}`);
  av.style.setProperty("--cor", COR[frescura(vistoEm(a))]); av.innerHTML = `<svg viewBox="0 0 24 24" aria-hidden="true">${FIGURA[a.perfil] || FIGURA.outro}</svg>`;
  cab.append(av);
  if (aRenomear === a.node_id) {
    const msg = el("p", "msg"); msg.id = "renomear-msg"; msg.setAttribute("role", "status"); msg.hidden = true;
    cab.append(formNome(a), msg);
  } else {
    const b = botaoNome(a.nome, t("nome.mudar", { nome: a.nome }));
    b.dataset.renomear = a.node_id; b.classList.add("geo-nome");
    b.addEventListener("click", () => abrirRenomear(a));
    cab.append(b);
  }
  const ids = [a.id]; if (estado.conta && estado.conta.administrador) ids.unshift(a.cliente);
  cab.append(el("span", "geo-id", ids.join(" · ")));
  c.append(cab);
  // estado em blocos
  const blocos = el("div", "geo-blocos");
  const bloco = (rotulo, valor, cls) => { const d = el("div", "geo-bloco" + (cls ? " " + cls : "")); d.append(el("span", "rotulo", rotulo), valor); return d; };
  const bat = elementoBateria(a.bateria);
  blocos.append(bloco(t("geo.bateria"), bat || el("b", null, "—")));
  if (a.perfil === "casa" && !a.ultima) {
    const f = textoFarol(a);
    blocos.append(bloco(t("geo.estado"), el("b", null, f.charAt(0).toUpperCase() + f.slice(1))));
  } else {
    blocos.append(bloco(t("geo.posicao"), el("b", null, a.ultima ? quando(a.ultima.hora) : t("aparelho.sem_posicoes"))));
    const gps = a.ultima && a.ultima.em_casa ? t("geo.em_casa", { zona: a.ultima.em_casa })
      : a.ultima && a.ultima.satelites ? t("aparelho.satelites", { n: a.ultima.satelites }) : "—";
    blocos.append(bloco(t("geo.gps"), el("b", null, gps)));
    // altitude da última posição (10/11/2026): o servidor e a rádio só a dão quando é de confiança (≥ 4 satélites)
    if (a.ultima && typeof a.ultima.altitude === "number" && !a.ultima.em_casa) {
      blocos.append(bloco(t("geo.altitude"), el("b", null, t("geo.altitude_valor", { n: a.ultima.altitude.toLocaleString(LOCALE) }))));
    }
  }
  c.append(blocos);
  // ações principais
  const acoes = el("div", "geo-acoes");
  if (a.repetidor) {
    // Repetidor da GEOREDE: equipamento da rede. Não recebe comandos por rádio e a posição é a aproximada que
    // mostra à comunidade; o estado completo está em Mais → Repetidores.
    c.append(el("p", "dica", t("rep.nota_geo")));
    const ver = el("button", "botao", t("rep.ver_estado")); ver.type = "button";
    ver.addEventListener("click", () => mudarVista("repetidores"));
    acoes.append(ver); c.append(acoes);
    return;
  }
  if (a.ultima) {
    const ir = el("button", "botao", t("seta.botao")); ir.type = "button";
    ir.addEventListener("click", () => setaAbrir(a.node_id)); acoes.append(ir);
  }
  if (!SEM_TOCAR.includes(a.perfil)) {
    const toc = el("button", "botao secundario", t("msg.tocar")); toc.type = "button";
    toc.addEventListener("click", () => fazerTocar(a.node_id, a.nome, "aparelhos-msg")); acoes.append(toc);
    // «Atualizar posição» (13/11/2026): pede a posição já, pela rádio (os Geos que dormem ou não se mexem ficam de fora)
    const pos = el("button", "botao secundario", t("msg.posicao")); pos.type = "button";
    pos.addEventListener("click", () => pedirPosicao(a.node_id, a.nome, "aparelhos-msg")); acoes.append(pos);
  }
  if (acoes.children.length) c.append(acoes);
  // outras ações, em linhas
  const lista = el("div", "geo-menu");
  const linha = (texto, icone, fn, extra) => {
    const b = el("button", "geo-menu-linha"); b.type = "button";
    b.innerHTML = `<span class="mais-ico">${icone}</span>`;
    const s = el("span", "geo-menu-txt", texto); if (extra) s.append(extra);
    b.append(s); b.insertAdjacentHTML("beforeend", '<svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>');
    b.addEventListener("click", fn); lista.append(b); return b;
  };
  linha(t("achado.botao"), '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><path d="M14 14h3v3h-3zM18 18h3v3h-3z"/></svg>', () => achadoAbrir(a));
  let extra = null;
  if (a.pendente) { extra = el("span", "a-aplicar", t("avancado.a_aplicar")); extra.title = t("avancado.a_aplicar_dica"); }
  else if (a.avancado) extra = el("span", "etiqueta", t("avancado.etiqueta"));
  linha(a.avancado ? t("avancado.desligar") : t("avancado.ligar"),
        '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/></svg>',
        () => a.avancado ? pedirEstado(a, "avancado", false) : confirmar(a, "avancado"), extra);
  c.append(lista);
  if (aConfirmar && aConfirmar.node_id === a.node_id && aConfirmar.acao === "avancado") c.append(caixaConfirmar(a));
  // no fundo, à parte: se algo correu mal
  c.append(el("p", "rotulo-grupo", t("geo.problemas")));
  const perigo = el("div", "geo-menu perigo");
  const per = el("button", "geo-menu-linha perdido", t("perdido.botao")); per.type = "button";
  per.addEventListener("click", () => confirmar(a, "perdido"));
  const lib = el("button", "geo-menu-linha libertar", t("libertar.botao_longo")); lib.type = "button";
  lib.addEventListener("click", () => confirmar(a, "libertar"));
  perigo.append(per, lib);
  c.append(perigo);
  if (aConfirmar && aConfirmar.node_id === a.node_id && aConfirmar.acao !== "avancado") {
    const cx = caixaConfirmar(a); c.append(cx);
    cx.scrollIntoView({ block: "nearest" });
  }
}

// ---- modo avançado e libertar (o aparelho é do cliente: pode sempre sair da GEOREDE)
let aConfirmar = null;          // { node_id, acao: "libertar" | "avancado" }
function acoesAparelho(a) {
  const div = document.createElement("div"); div.className = "aparelho-acoes";
  if (a.avancado) {
    const e = document.createElement("span"); e.className = "etiqueta"; e.textContent = t("avancado.etiqueta"); div.append(e);
  }
  if (a.pendente) {
    const p = document.createElement("span"); p.className = "a-aplicar"; p.textContent = t("avancado.a_aplicar");
    p.title = t("avancado.a_aplicar_dica");
    div.append(p);
  }
  const av = document.createElement("button"); av.type = "button";
  av.textContent = a.avancado ? t("avancado.desligar") : t("avancado.ligar");
  av.addEventListener("click", () => a.avancado ? pedirEstado(a, "avancado", false) : confirmar(a, "avancado"));
  const lib = document.createElement("button"); lib.type = "button"; lib.className = "perigo"; lib.textContent = t("libertar.botao");
  lib.addEventListener("click", () => confirmar(a, "libertar"));
  const per = document.createElement("button"); per.type = "button"; per.className = "perigo"; per.textContent = t("perdido.botao");
  per.addEventListener("click", () => confirmar(a, "perdido"));
  if (!SEM_TOCAR.includes(a.perfil)) {
    const toc = document.createElement("button"); toc.type = "button"; toc.textContent = t("msg.tocar");
    toc.addEventListener("click", () => fazerTocar(a.node_id, a.nome, "aparelhos-msg"));
    div.append(toc);
  }
  const qr = document.createElement("button"); qr.type = "button"; qr.textContent = t("achado.botao");
  qr.addEventListener("click", () => achadoAbrir(a));
  div.append(qr);
  div.append(av, lib, per);
  return div;
}
function confirmar(a, acao) {
  aConfirmar = { node_id: a.node_id, acao };
  desenharAparelhos();
  const b = document.querySelector(".confirmar-caixa .botao");
  if (b) b.focus();
}
function fecharConfirmar() { aConfirmar = null; desenharAparelhos(); }
function caixaConfirmar(a) {
  const c = document.createElement("div"); c.className = "confirmar-caixa"; c.setAttribute("role", "group");
  const p = document.createElement("p");
  const libertar = aConfirmar.acao === "libertar" || aConfirmar.acao === "perdido";
  p.textContent = t(aConfirmar.acao + ".confirmar", { nome: a.nome });
  const msg = document.createElement("p"); msg.className = "msg"; msg.id = "confirmar-msg"; msg.hidden = true;
  const botoes = document.createElement("div"); botoes.className = "botoes";
  const sim = document.createElement("button"); sim.type = "button";
  sim.className = libertar ? "botao perigo confirmar" : "botao"; sim.textContent = libertar ? t(aConfirmar.acao + ".botao") : t("avancado.confirmar_botao");
  sim.addEventListener("click", () => pedirEstado(a, aConfirmar.acao, true, sim));
  const nao = document.createElement("button"); nao.type = "button"; nao.className = "botao secundario"; nao.textContent = t("comum.cancelar");
  nao.addEventListener("click", fecharConfirmar);
  botoes.append(sim, nao);
  c.addEventListener("keydown", e => { if (e.key === "Escape") { e.preventDefault(); fecharConfirmar(); } });
  c.append(p, msg, botoes);
  return c;
}
async function pedirEstado(a, acao, ligar, botao) {
  if (botao) botao.disabled = true;
  try {
    const r = (acao === "libertar" || acao === "perdido")
      ? await enviar("/api/aparelho/" + acao, { node_id: a.node_id })
      : await enviar("/api/aparelho/avancado", { node_id: a.node_id, ligar });
    if (!r.ok) {
      const texto = r.corpo.erro || t("erro.pedido");
      if (document.getElementById("confirmar-msg")) mensagem("confirmar-msg", texto, true);
      else mensagem("aparelhos-msg", texto, true);
      return;
    }
    aConfirmar = null;
    if (acao === "libertar" || acao === "perdido") {
      estado.aparelhos = estado.aparelhos.filter(x => x.node_id !== a.node_id);
      const m = estado.marcadores.get(a.node_id);
      if (m) { m.remove(); estado.marcadores.delete(a.node_id); }
      if (estado.selecionado === a.node_id) estado.selecionado = null;
      mensagem("aparelhos-msg", t(acao + ".feito", { nome: a.nome }), false);
      desenharLista();
    } else {
      const tipo = ligar ? "avancado_ligar" : "avancado_desligar";
      const contrario = ligar ? "avancado_desligar" : "avancado_ligar";
      a.avancado = ligar;
      // como no servidor: o pedido contrário ainda por enviar é só anulado
      a.pendente = a.pendente === contrario ? null : tipo;
      mensagem("aparelhos-msg", t(ligar ? "avancado.ligado" : "avancado.desligado", { nome: a.nome }), false);
    }
    desenharAparelhos();
  } catch (e) {
    if (e.message !== "sessão expirada") mensagem("aparelhos-msg", t("erro.sem_ligacao"), true);
  } finally { if (botao) botao.disabled = false; }
}

// ---- painel do telemóvel com 3 alturas (revisão da UI, 09/11): «baixo» (só o título, o mapa todo à vista),
// «meio» (até metade do ecrã) e «alto» (quase o ecrã todo, o mapa escurece por trás).
// A pega e o título arrastam-se; dentro da lista, arrastar para cima no «meio» sobe primeiro o painel e só depois a
// lista rola; no «alto», com a lista no topo, arrastar para baixo desce o painel. Alertas, Mais, A tua rede, Sinal e
// Mensagens não têm mapa por trás: ocupam o ecrã inteiro (classe «cheio») e não se arrastam.
const painel = document.getElementById("painel");
const puxador = document.getElementById("puxador");
const painelFundo = document.getElementById("painel-fundo");
const eTelemovel = () => window.matchMedia("(max-width: 700px)").matches;
const ecraInteiro = () => painel.classList.contains("cheio");
function alturaPainel() {
  return painel.classList.contains("encolhido") ? "baixo" : painel.classList.contains("alto") ? "alto" : "meio";
}
// Tira a altura posta à mão (arrastar, animação): a partir daqui manda a classe
function limparAlturaMao() {
  clearTimeout(irPara.fim);
  if (gesto) { const g = gesto; gesto = null; g.alvo.removeEventListener("touchmove", moverGesto);
    g.alvo.removeEventListener("touchend", fimGesto); g.alvo.removeEventListener("touchcancel", fimGesto); }
  painel.classList.remove("a-arrastar");
  painel.style.transition = ""; painel.style.height = ""; painel.style.maxHeight = ""; painel.style.top = "";
}
function definirAltura(h) {
  painel.classList.toggle("encolhido", h === "baixo");
  painel.classList.toggle("alto", h === "alto");
  puxador.setAttribute("aria-expanded", String(h !== "baixo"));
  puxador.setAttribute("aria-label", t(h === "alto" ? "painel.descer" : h === "baixo" ? "painel.abrir" : "painel.subir"));
  painelFundo.hidden = !(eTelemovel() && h === "alto" && !ecraInteiro());
  pedirFade();
}
function encolherPainel(sim) { definirAltura(sim ? "baixo" : "meio"); }
const painelEncolhido = () => painel.classList.contains("encolhido");
const ACIMA = { baixo: "meio", meio: "alto", alto: "alto" }, ABAIXO = { alto: "meio", meio: "baixo", baixo: "baixo" };
let ignorarClique = false;
function semClique() { ignorarClique = true; setTimeout(() => { ignorarClique = false; }, 400); }
// Altura (px) de cada posição, para a animação acabar onde a classe vai pôr o painel
function alturaAlvo(h) {
  const r = painel.getBoundingClientRect();
  if (h === "baixo") return puxador.offsetHeight + document.getElementById("topo").offsetHeight + 10;
  if (h === "alto") return r.bottom - (document.getElementById("painel-sonda").getBoundingClientRect().top);
  const vista = document.getElementById("vista-" + estado.vista);
  let natural = 0;
  for (const el of painel.children) if (!el.hidden && el !== vista && getComputedStyle(el).display !== "none") natural += el.offsetHeight;
  natural += vista ? vista.scrollHeight : 0;
  return Math.min(natural + 4, window.innerHeight * 0.52);
}
function irPara(h) {
  if (h === alturaPainel() && !painel.style.height) return;
  const reduzir = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (reduzir || !eTelemovel()) { painel.style.height = ""; painel.style.maxHeight = ""; painel.style.top = ""; definirAltura(h); return; }
  const alvo = alturaAlvo(h);
  if (!painel.style.height) painel.style.height = painel.getBoundingClientRect().height + "px";
  painel.style.maxHeight = "none"; painel.style.top = "auto";
  void painel.offsetHeight;                                   // começa a animação a partir da altura de agora
  painel.classList.remove("a-arrastar");
  painel.style.transition = "height .22s ease";
  painel.style.height = alvo + "px";
  if (h === "alto") painelFundo.hidden = false;
  clearTimeout(irPara.fim);
  irPara.fim = setTimeout(() => {
    definirAltura(h);
    painel.style.transition = ""; painel.style.height = ""; painel.style.maxHeight = ""; painel.style.top = "";
  }, 230);
}
// Rato (computador, testes): arrastar a pega ou o título sobe ou desce uma posição
let arrasto = null;
function inicioArrasto(e) {
  if (!eTelemovel() || ecraInteiro() || e.pointerType === "touch" || (e.pointerType === "mouse" && e.button !== 0)) return;
  if (e.target.closest(".topo-btn")) return;
  arrasto = { y: e.clientY, id: e.pointerId };
  try { e.currentTarget.setPointerCapture(e.pointerId); } catch (err) { /* sem captura: segue sem ela */ }
}
function fimArrasto(e) {
  if (!arrasto || e.pointerId !== arrasto.id) return;
  const dy = e.clientY - arrasto.y;
  arrasto = null;
  if (Math.abs(dy) < 30) return;                 // foi um toque: trata-o o "click"
  semClique();
  irPara(dy > 0 ? ABAIXO[alturaPainel()] : ACIMA[alturaPainel()]);
}
for (const el of [puxador, document.getElementById("topo")]) {
  el.addEventListener("pointerdown", inicioArrasto);
  el.addEventListener("pointerup", fimArrasto);
  el.addEventListener("pointercancel", () => { arrasto = null; });
}
// Toque na pega: baixo → meio → alto → meio. Toque no título: abre se estiver em baixo, senão baixa.
puxador.addEventListener("click", () => {
  if (ignorarClique || !eTelemovel()) return;
  if (ecraInteiro()) { encolherPainel(!painelEncolhido()); return; }
  const h = alturaPainel();
  irPara(h === "baixo" ? "meio" : h === "meio" ? "alto" : "meio");
});
document.getElementById("topo").addEventListener("click", e => {
  if (ignorarClique || !eTelemovel() || !e.target.isConnected || e.target.closest(".topo-btn, .estado")) return;
  if (ecraInteiro()) { encolherPainel(!painelEncolhido()); return; }
  irPara(painelEncolhido() ? "meio" : "baixo");
});
painelFundo.addEventListener("click", () => irPara("meio"));
// Dedo: o painel segue o dedo e, ao largar, vai para a posição mais perto no sentido do gesto
let gesto = null;
painel.addEventListener("touchstart", e => {
  if (gesto) fimGesto();                         // gesto anterior sem fim (não devia acontecer): acaba-o
  gesto = null;
  if (!eTelemovel() || ecraInteiro() || e.touches.length !== 1) return;
  if (e.target.closest("input, textarea, select, .maplibregl-map, .rapidas, .fichas")) return;
  const y = e.touches[0].clientY;
  gesto = { y0: y, y, t0: Date.now(), h0: painel.getBoundingClientRect().height, modo: null, altura: alturaPainel(),
            naPega: !!e.target.closest(".puxador, .topo"), sc: document.getElementById("vista-" + estado.vista),
            alvo: e.target };
  e.target.addEventListener("touchmove", moverGesto, { passive: false });
  e.target.addEventListener("touchend", fimGesto);
  e.target.addEventListener("touchcancel", fimGesto);
}, { passive: true });
function moverGesto(e) {
  if (!gesto) return;
  gesto.y = e.touches[0].clientY;
  const dy = gesto.y - gesto.y0;
  if (!gesto.modo) {
    if (Math.abs(dy) < 8) return;
    const noTopo = !gesto.sc || gesto.sc.scrollTop <= 0;
    gesto.modo = gesto.naPega || gesto.altura === "baixo" ? "painel"
      : gesto.altura === "meio" ? (dy < 0 || noTopo ? "painel" : "lista")
      : (dy > 0 && noTopo ? "painel" : "lista");
    if (gesto.modo === "painel") {
      painel.classList.add("a-arrastar"); painel.style.maxHeight = "none"; painel.style.top = "auto";
      painel.style.height = gesto.h0 + "px"; painelFundo.hidden = true;
    }
  }
  if (gesto.modo !== "painel") return;
  if (e.cancelable) e.preventDefault();
  const max = alturaAlvo("alto"), min = alturaAlvo("baixo");
  painel.style.height = Math.max(min, Math.min(max, gesto.h0 - dy)) + "px";
}
function fimGesto() {
  const g = gesto; gesto = null;
  if (!g) return;
  g.alvo.removeEventListener("touchmove", moverGesto);
  g.alvo.removeEventListener("touchend", fimGesto);
  g.alvo.removeEventListener("touchcancel", fimGesto);
  if (g.modo !== "painel") return;
  semClique();
  const dy = g.y - g.y0, v = dy / Math.max(1, Date.now() - g.t0);       // px/ms (+ para baixo)
  let h = g.altura;
  if (dy < -50 || v < -0.5) h = ACIMA[h];
  else if (dy > 50 || v > 0.5) h = (h === "alto" && dy > g.h0 * 0.6) ? "baixo" : ABAIXO[h];
  irPara(h);
}
// Depois de arrastar não se carrega no botão onde o dedo começou
painel.addEventListener("click", e => { if (ignorarClique && !e.target.closest(".puxador, .topo")) { e.preventDefault(); e.stopPropagation(); } }, true);
window.matchMedia("(max-width: 700px)").addEventListener("change", e => { if (!e.matches) encolherPainel(false); });

// Esbatido em baixo enquanto houver mais lista para ver (no Android a barra de deslocar quase não se vê)
let fadePedido = false;
function pedirFade() {
  if (fadePedido) return; fadePedido = true;
  requestAnimationFrame(() => {
    fadePedido = false;
    for (const v of painel.querySelectorAll(".vista, .msg-conversas")) {
      v.classList.toggle("tem-mais", !v.hidden && v.scrollHeight - v.scrollTop - v.clientHeight > 8);
    }
  });
}
painel.addEventListener("scroll", pedirFade, true);
new MutationObserver(pedirFade).observe(painel, { childList: true, subtree: true, attributes: true, attributeFilter: ["hidden", "class"] });
window.addEventListener("resize", pedirFade);

// ---- «Em direto» no lugar de «Atualizado às 23:35» (revisão da UI, 09/11). Tocar atualiza já.
function desenharEstado() {
  const el = document.getElementById("estado");
