<script>
// GEOREDE — voz nas Mensagens (13/11/2026): ler em voz (🔊) e ditar (🎤 → texto).
// Na app Android usa o plugin nativo GeoredeVoz; no browser (PWA no iPhone, Chrome) usa a voz do próprio browser.
// Nada passa pelo servidor da GEOREDE. A mensagem ditada sai como texto normal (cabe num pacote da rádio).
(function () {
  "use strict";
  const LINGUAS = { pt: "pt-PT", en: "en-GB", es: "es-ES", fr: "fr-FR", de: "de-DE", it: "it-IT" };
  const CHAVE_AUTO = "georede-voz-ler-auto";
  const nativo = () => {
    try { return window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform()
      && window.Capacitor.Plugins && window.Capacitor.Plugins.GeoredeVoz || null; } catch (e) { return null; }
  };
  const lingua = () => {
    const l = (document.documentElement.lang || navigator.language || "pt").slice(0, 2).toLowerCase();
    return LINGUAS[l] || "pt-PT";
  };

  // Texto a dizer: as ligações não se leem (nem se abrem), dizem-se só «ligação»; espaços e símbolos repetidos fora.
  function limpar(t) {
    return String(t || "")
      .replace(/\b(?:https?:\/\/|www\.)\S+/gi, " ligação ")
      .replace(/([!?.,;:*_~#=+\-])\1{2,}/g, "$1")
      .replace(/\s+/g, " ")
      .trim()
      .slice(0, 600);
  }

  // ---------- ler em voz ----------
  async function ler(texto, opcoes) {
    const o = opcoes || {};
    const t = limpar(texto);
    if (!t) return false;
    const p = nativo();
    if (p) {
      try {
        let r = await p.falar({ texto: t, lingua: o.lingua || lingua(), fila: o.fila !== false });
        // Sem voz para a língua da mensagem: lê com a voz da app
        if (r && r.semVoz && o.alternativa && o.alternativa !== o.lingua) r = await p.falar({ texto: t, lingua: o.alternativa, fila: o.fila !== false });
        return !!(r && r.ok);
      }
      catch (e) { return false; }
    }
    if (!("speechSynthesis" in window)) return false;
    if (o.fila === false) speechSynthesis.cancel();
    const u = new SpeechSynthesisUtterance(t);
    u.lang = o.lingua || lingua();
    speechSynthesis.speak(u);
    return true;
  }

  function calar() {
    const p = nativo();
    if (p) { p.calar().catch(() => {}); return; }
    if ("speechSynthesis" in window) speechSynthesis.cancel();
  }

  // Frase de uma mensagem: «Ana: chego às oito» / «No Público, !a1b2c3d4: …»
  function frase(m) {
    const quem = m.de || m.nome || "";
    const onde = m.canal && m.canal !== "familia" ? (m.nomeCanal ? "Em " + m.nomeCanal + ", " : "") : "";
    return onde + (quem ? quem + ": " : "") + (m.texto || "");
  }

  // «Ler as que chegam»: chamar quando chega uma mensagem de outra pessoa.
  function chegou(m) {
    if (!lerAuto() || !m || m.minha) return;
    ler(frase(m), { fila: true });
  }
  function lerAuto(v) {
    try {
      if (typeof v === "boolean") localStorage.setItem(CHAVE_AUTO, v ? "1" : "0");
      return localStorage.getItem(CHAVE_AUTO) === "1";
    } catch (e) { return false; }
  }

  // ---------- ditar ----------
  let aOuvir = null;                       // { parar(), cancelar() }

  // ditar({ aoParcial(texto), aoEstado("a-ouvir"|"a-pensar"), soLocal }) → Promise<{texto, local}>
  async function ditar(opcoes) {
    const o = opcoes || {};
    if (aOuvir) throw Object.assign(new Error("já estou a ouvir"), { code: "ocupado" });
    calar();
    const p = nativo();
    if (p) {
      const ouvinte = await p.addListener("ditado", ev => {
        if (ev && ev.parcial && o.aoParcial) o.aoParcial(ev.texto || "");
        else if (ev && ev.estado && o.aoEstado) o.aoEstado(ev.estado);
      });
      aOuvir = { parar: () => p.acabarDitado(), cancelar: () => p.cancelarDitado() };
      try { return await p.ditar({ lingua: o.lingua || lingua(), soLocal: o.soLocal !== false }); }
      finally { aOuvir = null; try { ouvinte.remove(); } catch (e) {} }
    }
    const R = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!R) throw Object.assign(new Error("este browser não reconhece a voz"), { code: "sem-ditado" });
    // No browser o reconhecimento costuma ir aos servidores da Google/Apple: só com soLocal=false.
    if (o.soLocal !== false) throw Object.assign(new Error("no browser a voz vai para a Internet"), { code: "sem-local" });
    return new Promise((resolve, reject) => {
      const r = new R();
      r.lang = o.lingua || lingua();
      r.interimResults = true;
      r.continuous = false;
      r.maxAlternatives = 1;
      let final = "", parcial = "", cancelado = false;
      r.onstart = () => o.aoEstado && o.aoEstado("a-ouvir");
      r.onresult = ev => {
        parcial = "";
        for (let i = ev.resultIndex; i < ev.results.length; i++) {
          if (ev.results[i].isFinal) final += ev.results[i][0].transcript;
          else parcial += ev.results[i][0].transcript;
        }
        if (o.aoParcial) o.aoParcial((final + parcial).trim());
      };
      r.onerror = ev => {
        if (ev.error === "no-speech" || ev.error === "aborted") return;
        aOuvir = null;
        reject(Object.assign(new Error("o reconhecimento de voz falhou: " + ev.error),
          { code: ev.error === "not-allowed" ? "sem-microfone" : ev.error === "network" ? "sem-rede" : "erro" }));
      };
      r.onend = () => { aOuvir = null; resolve({ texto: cancelado ? "" : (final || parcial).trim(), local: false }); };
      aOuvir = { parar: () => r.stop(), cancelar: () => { cancelado = true; r.abort(); } };
      r.start();
    });
  }
  const acabarDitado = () => { if (aOuvir) aOuvir.parar(); };
  const cancelarDitado = () => { if (aOuvir) aOuvir.cancelar(); };

  async function estado() {
    const p = nativo();
    if (p) { try { return Object.assign({ nativo: true }, await p.estado({ lingua: lingua() })); } catch (e) {} }
    return {
      nativo: false,
      fala: "speechSynthesis" in window,
      ouve: !!(window.SpeechRecognition || window.webkitSpeechRecognition),
      local: false
    };
  }

  // Língua de cada texto (ML Kit no telemóvel, só na app Android). Devolve [{lingua, confianca}] ou null.
  const cacheLinguas = new Map();
  async function detetar(textos) {
    const p = nativo();
    if (!p || !p.detetarLingua || !textos || !textos.length) return null;
    const faltam = [...new Set(textos.filter(x => !cacheLinguas.has(x)))].slice(0, 30);
    if (faltam.length) {
      try {
        const r = await p.detetarLingua({ textos: faltam });
        (r && r.linguas || []).forEach((x, i) => cacheLinguas.set(faltam[i], x));
        if (cacheLinguas.size > 500) cacheLinguas.delete(cacheLinguas.keys().next().value);
      } catch (e) { return null; }
    }
    return textos.map(x => cacheLinguas.get(x) || { lingua: "und", confianca: 0 });
  }

  // Android 13+: vê se a língua está no reconhecimento do telemóvel e, se faltar, pede para a transferir
  async function prepararLingua(l) {
    const p = nativo();
    if (!p || !p.prepararLingua) return { sabe: false };
    try { return await p.prepararLingua({ lingua: l || lingua() }); } catch (e) { return { sabe: false }; }
  }

  window.georedeVoz = { ler, detetar, prepararLingua, calar, frase, chegou, lerAuto, ditar, acabarDitado, cancelarDitado, estado, limpar, LINGUAS };
})();
</script>
