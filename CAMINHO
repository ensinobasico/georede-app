// «Visto há»: a hora da última posição; nos Geos de outras redes (vista da equipa) só vem a hora, sem a posição
// O Farol (Geo Casa) não tem GPS: «visto» é a última leitura que mandou (de 10 em 10 min). Revisão da UI (09/11):
// assim o Farol tem o mesmo estado no Mapa, em «A tua rede» e no Sinal, em vez de «sem posições».
function vistoEm(a) {
  // ouvido: a última receção que passou pelo Farol (API, 09/11); a telemetria do Farol só se não houver
  return (a.ultima && a.ultima.hora) || a.visto || (a.perfil === "casa" && (a.ouvido || (a.bateria && a.bateria.hora))) || null;
