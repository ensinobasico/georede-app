<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20viewBox%3D%2240%2040%20320%20320%22%3E%3Cdefs%3E%3ClinearGradient%20id%3D%22g%22%20x1%3D%2240%22%20y1%3D%2240%22%20x2%3D%22360%22%20y2%3D%22360%22%20gradientUnits%3D%22userSpaceOnUse%22%3E%3Cstop%20offset%3D%220%22%20stop-color%3D%22%231E90FF%22/%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%2319E68C%22/%3E%3C/linearGradient%3E%3C/defs%3E%3Cpath%20d%3D%22M299%20101A140%20140%200%201%200%20340%20200%22%20fill%3D%22none%22%20stroke%3D%22url%28%23g%29%22%20stroke-width%3D%2232%22%20stroke-linecap%3D%22round%22/%3E%3Cpath%20d%3D%22M340%20200H190%22%20fill%3D%22none%22%20stroke%3D%22url%28%23g%29%22%20stroke-width%3D%2232%22%20stroke-linecap%3D%22round%22/%3E%3Cpath%20d%3D%22M190%20200%20299%20101%22%20stroke%3D%22url%28%23g%29%22%20stroke-width%3D%2211%22%20stroke-linecap%3D%22round%22/%3E%3Ccircle%20cx%3D%22299%22%20cy%3D%22101%22%20r%3D%2230%22%20fill%3D%22url%28%23g%29%22/%3E%3Ccircle%20cx%3D%22190%22%20cy%3D%22200%22%20r%3D%2236%22%20fill%3D%22url%28%23g%29%22/%3E%3C/svg%3E">
<link rel="stylesheet" href="/vendor/maplibre-gl.css" onerror="this.onerror=null;this.href='https://unpkg.com/maplibre-gl@5/dist/maplibre-gl.css'">
<style>
  /* A página nunca aumenta nem diminui: só o mapa responde aos dois dedos (o MapLibre trata o gesto ele próprio).
     pan-x pan-y deixa deslizar mas tira ao navegador o zoom com dois dedos e com duplo toque. */
  html, body { touch-action: pan-x pan-y; }
  #mapa, #mapa .maplibregl-canvas-container, #mapa canvas { touch-action: none; }
  :root {
    --azul: #1E5BB8;
    --verde: #2E9E6B;
    --ambar: #B7791F;
    --tinta: #1C2430;
    --tinta-2: #556171;
    --painel: #FFFFFF;
    --nevoa: #EEF2F5;
    --linha: #DCE3EA;
    --foco: #1E5BB8;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --tinta: #E6EBF0;
      --tinta-2: #9AA7B6;
      --painel: #151B23;
      --nevoa: #1E2631;
      --linha: #2A3441;
      --foco: #7FB0F5;
    }
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; }
  body {
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 15px; line-height: 1.45; color: var(--tinta); background: var(--nevoa);
  }
  #mapa { position: fixed; inset: 0 0 0 var(--nav-largura); }
  :root { --nav-largura: 208px; --nav-altura: 0px; }

  /* Navegação: coluna à esquerda no computador, barra em baixo no telemóvel */
  .navegacao {
    position: fixed; z-index: 3; top: 0; left: 0; bottom: 0; width: var(--nav-largura);
    display: flex; flex-direction: column; background: var(--painel); border-right: 1px solid var(--linha);
  }
  .navegacao .marca-nav { display: flex; align-items: center; gap: 10px; padding: 22px 20px 20px; }
  .logo-nav { display: block; width: 168px; height: auto; color: var(--tinta); }
  .navegacao ul { list-style: none; margin: 0; padding: 0 10px; display: flex; flex-direction: column; gap: 2px; flex: 1; }
  .navegacao a {
    display: flex; align-items: center; gap: 12px; padding: 9px 12px; border-radius: 10px;
    color: var(--tinta-2); text-decoration: none; font-size: 15px;
  }
  .navegacao a:hover { background: var(--nevoa); color: var(--tinta); }
  .navegacao a[aria-current="page"] { background: color-mix(in srgb, var(--azul) 12%, transparent); color: var(--azul); font-weight: 600; }
  @media (prefers-color-scheme: dark) { .navegacao a[aria-current="page"] { color: var(--foco); } }
  .navegacao svg.ico { width: 20px; height: 20px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .navegacao .rotulo { flex: 1; }
  .navegacao .breve { font-size: 10px; font-weight: 600; letter-spacing: .03em; text-transform: uppercase; color: var(--tinta-2); opacity: .75; }
  .navegacao .so-movel { display: none; }
  .nav-rodape { padding: 12px 16px 16px; border-top: 1px solid var(--linha); font-size: 13px; color: var(--tinta-2); }
  .nav-rodape .conta { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-bottom: 8px; }

  .painel {
    position: fixed; z-index: 2; top: 16px; left: calc(var(--nav-largura) + 16px); bottom: 16px; width: 320px;
    display: flex; flex-direction: column;
    background: var(--painel); border: 1px solid var(--linha); border-radius: 14px;
    box-shadow: 0 6px 24px rgba(20, 35, 55, .14); overflow: hidden;
  }
  .topo { display: flex; align-items: center; gap: 10px; padding: 16px 18px 12px; }
  .marca { font-weight: 650; font-size: 19px; letter-spacing: -.01em; }
  .topo h1 { margin: 0; font-size: 18px; font-weight: 650; }
  .topo .estado { margin-left: auto; font-size: 12px; color: var(--tinta-2); }
  .topo .seta { display: none; }
  @media (max-width: 700px) { .topo .seta { display: block; } }

  .periodo { display: flex; gap: 4px; padding: 0 18px 12px; }
  .periodo button {
    flex: 1; font: inherit; font-size: 13px; padding: 6px 0; cursor: pointer;
    color: var(--tinta-2); background: var(--nevoa); border: 1px solid transparent; border-radius: 8px;
  }
  .periodo button[aria-pressed="true"] { color: var(--tinta); background: var(--painel); border-color: var(--linha); font-weight: 600; }
  /* Mapa: trajeto das últimas 24 h ou desde o último "Limpar" (o resto fica no Histórico) */
  .trajeto-barra { display: flex; align-items: center; gap: 8px; padding: 0 18px 12px; font-size: 13px; color: var(--tinta-2); }
  /* O texto («L1 Pro: últimas 24 h») tem a linha toda; os botões vão por baixo, e «Limpar» encosta à direita */
  .trajeto-barra { flex-wrap: wrap; row-gap: 8px; }
  .trajeto-barra .texto { flex: 1 1 100%; min-width: 0; }
  .trajeto-barra { flex-wrap: wrap; }
  .trajeto-barra #trajeto-todo { margin-left: auto; }
  .trajeto-periodos { display: flex; gap: 6px; flex-basis: 100%; }
  .trajeto-periodos button { padding: 6px 12px; border-radius: 999px; min-height: 36px; opacity: .7; }
  .trajeto-periodos button[aria-pressed="true"] { opacity: 1; font-weight: 700; box-shadow: inset 0 0 0 2px currentColor; }
  .trajeto-barra button {
    font: inherit; font-size: 13px; padding: 6px 12px; cursor: pointer; white-space: nowrap;
    color: var(--tinta); background: var(--nevoa); border: 1px solid transparent; border-radius: 8px;
  }
  .trajeto-barra button.ligacao { background: none; padding: 6px 4px; color: var(--azul); text-decoration: underline; }
  #vista-historico .periodo { padding: 4px 18px 10px; }

  .lista { list-style: none; margin: 0; padding: 4px 8px 8px; overflow-y: auto; flex: 1; border-top: 1px solid var(--linha); }
  .lista button {
    width: 100%; display: grid; grid-template-columns: 14px 1fr auto; align-items: center; gap: 4px 10px;
    padding: 10px; text-align: left; font: inherit; color: inherit; cursor: pointer;
    background: none; border: 0; border-radius: 10px;
  }
  .lista button:hover { background: var(--nevoa); }
  .lista button[aria-current="true"] { background: var(--nevoa); box-shadow: inset 3px 0 0 var(--azul); }
  .nome { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .visto { font-size: 13px; color: var(--tinta-2); white-space: nowrap; }
  .detalhe { grid-column: 2 / 4; font-size: 13px; color: var(--tinta-2); }

  .ponto { width: 12px; height: 12px; border-radius: 50%; background: var(--tinta-2); }
  .ponto.fresco { background: var(--verde); }
  .ponto.recente { background: var(--azul); }
  .ponto.antigo { background: var(--ambar); }

  .vazio, .aviso { margin: 12px 18px; font-size: 14px; color: var(--tinta-2); }
  .aviso { color: var(--ambar); }
  .rodape { display: flex; align-items: center; gap: 10px; padding: 10px 18px 14px; font-size: 13px; color: var(--tinta-2); border-top: 1px solid var(--linha); }
  .rodape .conta { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rodape form { margin: 0; }
  .sair { font: inherit; font-size: 13px; padding: 5px 12px; cursor: pointer; color: var(--tinta); background: var(--painel); border: 1px solid var(--linha); border-radius: 8px; }
  .sair:hover { background: var(--nevoa); }
  .admin { margin: 0 18px 10px; font-size: 12px; color: var(--ambar); }

  .cartao { margin: 4px 18px 14px; padding: 14px; border: 1px solid var(--linha); border-radius: 12px; background: var(--nevoa); }
  .cartao h2 { margin: 0 0 4px; font-size: 15px; }
  .cartao p { margin: 0 0 10px; font-size: 13px; color: var(--tinta-2); }
  .cartao label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 4px; }
  .linha-form { display: flex; gap: 6px; }
  .linha-form input {
    flex: 1; min-width: 0; font: inherit; padding: 7px 10px; color: var(--tinta);
    background: var(--painel); border: 1px solid var(--linha); border-radius: 8px;
  }
  #codigo { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; letter-spacing: .06em; text-transform: uppercase; }
  .botao { font: inherit; font-size: 14px; font-weight: 600; padding: 7px 14px; cursor: pointer; color: #fff; background: var(--azul); border: 0; border-radius: 8px; }
  .botao:disabled { opacity: .6; cursor: default; }
  .botao.secundario { color: var(--tinta); background: var(--painel); border: 1px solid var(--linha); font-weight: 500; }
  .msg { margin: 8px 0 0; font-size: 13px; }
  .msg.erro { color: #C2410C; }
  @media (prefers-color-scheme: dark) { .msg.erro { color: #FB923C; } .botao { color: #0B1220; background: var(--foco); } }
  .mudar { margin: -4px 0 6px 34px; padding: 2px 6px; font: inherit; font-size: 12px; color: var(--azul); background: none; border: 0; border-radius: 6px; cursor: pointer; text-decoration: underline; }
  @media (prefers-color-scheme: dark) { .mudar { color: var(--foco); } }

  [hidden] { display: none !important; }
  .contador { display: inline-block; min-width: 18px; padding: 0 5px; margin-left: 4px; font-size: 11px; line-height: 18px; font-weight: 700; color: #fff; background: #C2410C; border-radius: 9px; }
  .vista { display: flex; flex-direction: column; flex: 1; min-height: 0; overflow-y: auto; }
  .vista > .lista { flex: 1; }
  /* A tua rede: a lista não encolhe por causa do que vem por baixo (pessoas, Adicionar um Geo); rola a vista toda */
  #vista-aparelhos > .lista { flex: none; overflow: visible; }
  .rotulo-secao { margin: 0 18px 8px; font-size: 13px; color: var(--tinta-2); }
  .acoes { display: flex; gap: 8px; padding: 0 18px 12px; }

  .lista .zona-cor { width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--verde); background: color-mix(in srgb, var(--verde) 20%, transparent); }
  .lista .alerta-ico { display: block; width: 12px; height: 12px; border-radius: 3px; justify-self: center; }
  .lista button.mudar { display: inline-block; width: auto; margin: -4px 0 6px 34px; padding: 2px 6px; font-size: 12px; color: var(--azul); }
  .lista button.mudar:hover { background: var(--nevoa); }
  @media (prefers-color-scheme: dark) { .lista button.mudar { color: var(--foco); } }
  .cartao label.opcao { display: flex; font-weight: 400; margin: 0; }
  .alerta-ico.tipo-sair { background: var(--ambar); }
  .alerta-ico.tipo-entrar { background: var(--verde); }
  .alerta-ico.tipo-sem_sinal { background: var(--tinta-2); }
  .alerta-ico.tipo-bateria { background: var(--erro); }
  .alerta-ico.tipo-encontrei { background: var(--verde, #16A34A); }

  /* Bateria: ícone com a carga e a percentagem (vermelho quando está fraca) */
  :root { --erro: #C2410C; }
  @media (prefers-color-scheme: dark) { :root { --erro: #FB923C; } }
  .bateria {
    display: inline-flex; align-items: center; gap: 4px; margin-right: 8px; vertical-align: -1px;
    color: var(--tinta-2); font-variant-numeric: tabular-nums; white-space: nowrap;
  }
  .bateria svg { width: 20px; height: 11px; flex: none; }
  .bateria .contorno { fill: none; stroke: currentColor; stroke-width: 1.5; }
  .bateria .polo { fill: currentColor; }
  .bateria .carga { fill: var(--verde); }
  .bateria .raio { fill: var(--painel); }
  .bateria.fraca { color: var(--erro); font-weight: 600; }
  .bateria.fraca .carga { fill: var(--erro); }
  .bateria.antiga { opacity: .6; }

  .campo { margin-bottom: 12px; }
  .campo:last-child { margin-bottom: 0; }
  .campo > input[type=text] { width: 100%; font: inherit; padding: 7px 10px; color: var(--tinta); background: var(--painel); border: 1px solid var(--linha); border-radius: 8px; }
  .campo input[type=range] { width: 100%; accent-color: var(--azul); }
  .raio-valor { float: right; font-weight: 600; font-variant-numeric: tabular-nums; }
  .opcao { display: flex; align-items: center; gap: 8px; font-size: 14px; padding: 3px 0; cursor: pointer; }
  .opcao input { width: 16px; height: 16px; accent-color: var(--azul); margin: 0; }
  .sub-opcoes { margin: 2px 0 0 24px; }
  .dica { font-size: 12px; color: var(--tinta-2); margin: 4px 0 0; }
  .botoes { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
  .botao.perigo { margin-left: auto; color: #B42318; background: var(--painel); border: 1px solid var(--linha); font-weight: 500; }
  .botao.perigo.confirmar { color: #fff; background: #B42318; border-color: #B42318; }
  @media (prefers-color-scheme: dark) { .botao.perigo { color: #FDA29B; } .botao.perigo.confirmar { color: #fff; } }
  .preferencia { margin: 0 18px 10px; }
  .push-caixa { margin-top: -4px; }
  .push-caixa .dica { margin: 4px 0 0 24px; }
  .push-caixa .dica.erro { color: var(--erro); }
  .push-caixa .testar {
    margin: 6px 0 0 24px; padding: 0; font: inherit; font-size: 13px; color: var(--azul); background: none; border: 0;
    cursor: pointer; text-decoration: underline; text-underline-offset: 2px;
  }
  .push-caixa .testar:disabled { opacity: .6; cursor: default; }
  @media (prefers-color-scheme: dark) { .push-caixa .testar { color: var(--foco); } }

  .toast {
    position: fixed; z-index: 5; top: calc(16px + env(safe-area-inset-top)); left: 50%; transform: translateX(-50%); max-width: calc(100% - 32px);
    display: flex; align-items: center; gap: 10px; padding: 10px 14px; font-size: 14px;
    color: var(--tinta); background: var(--painel); border: 1px solid var(--linha); border-left: 4px solid var(--ambar);
    border-radius: 10px; box-shadow: 0 8px 28px rgba(20,35,55,.22); cursor: pointer;
  }
  .toast.tipo-entrar { border-left-color: var(--verde); }
  .toast.tipo-sem_sinal { border-left-color: var(--tinta-2); }
  .toast.tipo-bateria { border-left-color: var(--erro); }
  .toast.tipo-encontrei { border-left-color: var(--verde, #16A34A); }
  @media (min-width: 701px) { .toast { left: calc(50% + (var(--nav-largura) + 336px) / 2); } }

  .em-breve { margin: 4px 18px 16px; padding: 18px; border: 1px dashed var(--linha); border-radius: 12px; }
  .em-breve .selo { display: inline-block; margin-bottom: 8px; padding: 2px 8px; font-size: 11px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--azul); background: color-mix(in srgb, var(--azul) 12%, transparent); border-radius: 6px; }
  @media (prefers-color-scheme: dark) { .em-breve .selo { color: var(--foco); } }
  .em-breve h2 { margin: 0 0 6px; font-size: 16px; }
  .em-breve p { margin: 0 0 8px; font-size: 14px; color: var(--tinta-2); }
  .em-breve ul { margin: 0; padding-left: 18px; font-size: 14px; color: var(--tinta-2); }
  .hist-topo { display: flex; align-items: center; gap: 10px; padding: 0 18px 10px; }
  .hist-topo .rotulo-secao { margin: 0; }
  #zona-farol { width: 100%; font: inherit; padding: 8px 10px; color: var(--tinta); background: var(--painel); border: 1px solid var(--linha); border-radius: 8px; }
  #zona-farol-campo .dica { margin: 6px 0 0; font-size: 13px; color: var(--tinta-2); }
  #zona-farol-campo .farol-info { color: var(--tinta); }
  #zona-farol-reaprender { margin-top: 8px; }
  #zona-farol-reaprender[hidden] { display: none; }
  .hist-topo select { flex: 1; min-width: 0; font: inherit; padding: 7px 10px; color: var(--tinta); background: var(--painel); border: 1px solid var(--linha); border-radius: 8px; }
  .hist-total { margin: 0 18px 12px; font-size: 14px; color: var(--tinta-2); }
  .hist-total strong { color: var(--tinta); font-size: 20px; font-variant-numeric: tabular-nums; margin-right: 4px; }
  .lista .km { font-weight: 600; font-variant-numeric: tabular-nums; }
  .barra { grid-column: 2 / 4; height: 4px; border-radius: 2px; background: var(--nevoa); overflow: hidden; }
  .barra > span { display: block; height: 100%; background: linear-gradient(90deg, var(--azul), var(--verde)); border-radius: 2px; }
  .lista-mais { list-style: none; margin: 0; padding: 4px 8px; }
  .lista-mais a { display: flex; align-items: center; gap: 12px; padding: 12px 10px; border-radius: 10px; color: var(--tinta); text-decoration: none; }
  .lista-mais a:hover { background: var(--nevoa); }
  .lista-mais svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; color: var(--tinta-2); }
  .conta-mais { margin: 8px 18px 16px; padding-top: 12px; border-top: 1px solid var(--linha); font-size: 13px; color: var(--tinta-2); }
  .conta-mais span { display: block; margin-bottom: 8px; overflow: hidden; text-overflow: ellipsis; }
  .aparelho-linha { display: grid; grid-template-columns: 14px 1fr auto; align-items: center; gap: 4px 10px; padding: 10px; border-radius: 10px; }
  .aparelho-linha .detalhe { grid-column: 2 / 4; }
  /* Modo avançado e libertar */
  .aparelho-acoes { grid-column: 2 / 4; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 14px; margin-top: 2px; font-size: 13px; }
  .lista .aparelho-acoes button, .lista .confirmar-caixa button.ligacao {
    display: inline; width: auto; padding: 2px 0; font: inherit; font-size: 13px; color: var(--azul);
    background: none; border: 0; border-radius: 4px; cursor: pointer; text-decoration: underline; text-underline-offset: 2px;
  }
  .lista .aparelho-acoes button:hover { background: none; text-decoration-thickness: 2px; }
  .lista .aparelho-acoes button.perigo { color: #B42318; }
  @media (prefers-color-scheme: dark) { .lista .aparelho-acoes button { color: var(--foco); } .lista .aparelho-acoes button.perigo { color: #FDA29B; } }
  .etiqueta { padding: 1px 8px; font-size: 11px; font-weight: 600; border-radius: 9px; color: var(--ambar); background: color-mix(in srgb, var(--ambar) 14%, transparent); }
  .a-aplicar { display: inline-flex; align-items: center; gap: 6px; color: var(--tinta-2); }
  .a-aplicar::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--ambar); animation: piscar 1.6s ease-in-out infinite; }
  @keyframes piscar { 50% { opacity: .3; } }
  @media (prefers-reduced-motion: reduce) { .a-aplicar::before { animation: none; } }
  .confirmar-caixa { grid-column: 2 / 4; margin-top: 6px; padding: 12px; border: 1px solid var(--linha); border-radius: 10px; background: var(--nevoa); }
  .confirmar-caixa p { margin: 0 0 10px; font-size: 13px; color: var(--tinta); }
  .confirmar-caixa .botoes { margin-top: 0; }
