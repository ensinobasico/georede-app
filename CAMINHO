// "7 satélites" para o cliente; "c0001, !47520001, 7 satélites" para os administradores (o ID do Geo não diz nada
// a quem usa a app). O Farol (Geo Casa) não tem GPS: em vez de "sem posições ainda" diz o que faz.
// Em «A tua rede» (comId) o ID fica: é o que está escrito na caixa do Geo, para saber qual é qual.
function detalheAparelho(a, extra, comId = false) {
  const partes = [];
  const admin = !!(estado.conta && estado.conta.administrador);
  if (admin) partes.push(a.cliente);
  if (admin || comId) partes.push(a.id);
  // Ouvido pelo Farol da zona: está em casa (o servidor já pôs o marcador no centro da zona)
  if (a.ultima && a.ultima.em_casa) partes.push(t("aparelho.em_casa", { zona: a.ultima.em_casa }));
  // Os satélites são um pormenor técnico: ficam no ecrã do Geo e para a equipa (revisão da UI, 09/11)
  else if (a.ultima && a.ultima.satelites && admin) partes.push(t("aparelho.satelites", { n: a.ultima.satelites }));
  if (!a.ultima && a.perfil === "casa") extra = textoFarol(a);
  if (extra) partes.push(extra);
  const txt = partes.filter(Boolean).join(", ");
  return admin || comId ? txt : txt.charAt(0).toUpperCase() + txt.slice(1);
}

function desenharMarcadores() {
  const vistos = new Set();
  for (const a of estado.aparelhos) {
    if (!a.ultima) continue;
    vistos.add(a.node_id);
    const f = frescura(a.ultima.hora);
    let m = estado.marcadores.get(a.node_id);
    if (!m) {
      const el = document.createElement("div");
      el.setAttribute("role", "button");
      el.setAttribute("tabindex", "0");
      el.addEventListener("click", () => selecionar(a.node_id));
      el.addEventListener("keydown", e => { if (e.key === "Enter" || e.key === " ") selecionar(a.node_id); });
      el.innerHTML = '<span class="nome"></span><span class="fig"></span>';
      m = new maplibregl.Marker({ element: el }).setLngLat([a.ultima.lon, a.ultima.lat]).addTo(mapa);
      estado.marcadores.set(a.node_id, m);
    }
    const el = m.getElement();
    if (el.dataset.perfil !== (a.perfil || "outro")) {      // o perfil pode mudar (A tua rede)
      el.dataset.perfil = a.perfil || "outro";
      el.querySelector(".fig").innerHTML = figura(a.perfil);
    }
    el.querySelector(".nome").textContent = a.nome;
    const procura = emProcura(a.node_id);
    el.className = `marcador ${f}${a.node_id === estado.selecionado ? " selecionado" : ""}${procura ? " procura" : ""}${a.exemplo ? " exemplo" : ""}`;
    el.style.setProperty("--cor", procura ? COR_PROCURA : COR[f]);
    el.setAttribute("aria-label", t("marcador.rotulo", { nome: a.nome, quando: quando(a.ultima.hora) }));
    el.title = t("marcador.titulo", { nome: a.nome, quando: quando(a.ultima.hora) });
    m.setLngLat([a.ultima.lon, a.ultima.lat]);
  }
  for (const [id, m] of estado.marcadores) {
    if (!vistos.has(id)) { m.remove(); estado.marcadores.delete(id); }
  }
}

function enquadrarTodos() {
  const pts = estado.aparelhos.filter(a => a.ultima).map(a => [a.ultima.lon, a.ultima.lat]);
  if (!pts.length) return;
  if (pts.length === 1) { mapa.jumpTo({ center: pts[0], zoom: 15 }); return; }
  const b = pts.reduce((b, p) => b.extend(p), new maplibregl.LngLatBounds(pts[0], pts[0]));
  mapa.fitBounds(b, { padding: margens(), maxZoom: 15, duration: 0 });
}
// No telemóvel: em cima, espaço para a barra de estado e o nome por cima do marcador (antes o nome do Geo ficava
// por baixo da barra de estado); em baixo, a altura do painel.
function margens() {
  if (window.innerWidth > 700) return { top: 50, bottom: 50, left: 370, right: 60 };
  const p = painel.getBoundingClientRect().height;
  return { top: 90, bottom: Math.min(painelEncolhido() ? 90 : p + 30, window.innerHeight * 0.6), left: 40, right: 40 };
}

async function carregarTrajeto(enquadrar) {
  const fonte = mapa.getSource("trajeto");
  if (!fonte) return;
  const rota = estado.vista === "rotas" && estado.rotas && estado.rotas.aberta ? estado.rotas.aberta : null;
  const hist = !rota && estado.vista === "historico" && (estado.hist.dia || estado.hist.horas) ? estado.hist : null;
  const node = hist ? hist.node_id : estado.selecionado;
  if (!rota && node === null) { fonte.setData({ type: "FeatureCollection", features: [] }); return; }
  // Só os Geos da rede da conta têm trajeto no servidor. Um repetidor, um Geo de outra rede (vista da equipa) ou
  // um equipamento só ouvido pela rádio não têm: pedir dava 404 e a app ficava a dizer «Sem ligação» (12/11/2026).
  if (!rota) {
    const a = estado.aparelhos.find(x => x.node_id === node);
    const daRede = a && !a.repetidor && !a.sintetico && (!a.cliente || !estado.conta || a.cliente === estado.conta.cliente_id);
    if (a && !daRede) { fonte.setData({ type: "FeatureCollection", features: [] }); estado.trajetoAtual = null; return; }
  }
  let g = await obter(rota ? `/api/rota?id=${rota}`
                      : hist ? (hist.horas ? `/api/trajeto?node_id=${node}&horas=${hist.horas}`
                                           : `/api/trajeto?node_id=${node}&dia=${hist.dia}`)
                             : `/api/trajeto?node_id=${node}&horas=${limpoEm(node) ? 24 : periodoH()}`);
  if (!rota && !hist) g = cortarTrajeto(g, limpoEm(node)); // no mapa: só desde o último "Limpar" deste Geo
  fonte.setData(g);
  estado.trajetoAtual = g;
  if (!enquadrar) return;
  if (!rota && !hist) {   // no mapa o zoom é de quem usa; «Ver todo» enquadra o trajeto
    const a = estado.aparelhos.find(x => x.node_id === node);
    if (a && a.ultima) mapa.easeTo({ center: [a.ultima.lon, a.ultima.lat], zoom: Math.max(mapa.getZoom(), 15), duration: 600 });
    return;
  }
  let pts = g.features.filter(f => f.properties.tipo === "ponto").map(f => f.geometry.coordinates);
  if (!pts.length) { const l = g.features.find(f => f.properties.tipo === "linha"); if (l) pts = l.geometry.coordinates; }
  if (pts.length > 1) {
    const b = pts.reduce((b, p) => b.extend(p), new maplibregl.LngLatBounds(pts[0], pts[0]));
    mapa.fitBounds(b, { padding: margens(), maxZoom: 17 });
  } else {
    const a = estado.aparelhos.find(x => x.node_id === node);
    if (a && a.ultima && !hist && !rota) mapa.flyTo({ center: [a.ultima.lon, a.ultima.lat], zoom: Math.max(mapa.getZoom(), 15) });
  }
}

async function selecionar(nodeId) {
  if (estado.editor) return;               // a desenhar uma zona: os cliques são para o mapa
  if (estado.vista !== "mapa") mudarVista("mapa");
  estado.selecionado = nodeId;
  desenharLista();
  desenharMarcadores();
  desenharBarraTrajeto();
  try { await carregarTrajeto(true); } catch (e) { mostrarErro(e); }
}

function semInternet(e) {
  // Sem rede, o fetch falha antes de haver resposta do servidor. Cada browser escreve a sua mensagem:
  // Chrome "Failed to fetch", Firefox "NetworkError…", Safari "Load failed". Outros erros de código não contam.
  return !navigator.onLine || (e && e.name === "TypeError" && /failed to fetch|networkerror|load failed|sem internet/i.test(e.message));
}

function mostrarErro(e) {
  if (String(e.message) === "sessão expirada") return;
  console.error(e);
  if (semInternet(e) && saiuDaConta() && typeof mostrarSaiu === "function") mostrarSaiu();
  // Revisão da UI (11/11): o erro de ligação fica na etiqueta «Em direto», sem tapar o painel.
  estado.erroLigacao = semInternet(e) ? t("erro.sem_internet") : t("erro.dados", { s: ATUALIZAR_S });
  estado.erroEm = Date.now();
  desenharEstado();
}

// Com sessão válida, pede ao sw.js para guardar (ou refrescar) a cópia da app no telemóvel
function pedirGuardarApp() {
  if (!("serviceWorker" in navigator)) return;
  navigator.serviceWorker.ready
    .then(r => { if (r.active) r.active.postMessage({ tipo: "guardar-app" }); })
    .catch(() => null);
}

// Sem internet: a app abre na mesma (guardada no telemóvel pelo sw.js) e avisa.
