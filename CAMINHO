  @media (prefers-color-scheme: dark) { .opcao.interruptor input:checked { background: #3B6FD0; } }
  .opcao.interruptor input:focus-visible { outline: 2px solid var(--foco); outline-offset: 2px; }
  .aviso-form .opcao.interruptor { padding: 6px 0; min-height: 44px; font-size: 14px; }

  /* 3.x Mais: Fundador numa linha; menu com ícone, estado e › */
  #vista-mais .rede-plano, #rede-lista .rede-plano { margin: 4px 16px 14px; padding: 14px; border: 1px solid color-mix(in srgb, var(--azul) 35%, var(--linha));
    border-radius: 14px; background: color-mix(in srgb, var(--azul) 8%, var(--painel)); gap: 6px; }
  .rede-plano.pago { background: var(--nevoa); border-color: var(--linha); }
  .rede-plano.pago b { color: var(--verde); }
  .plano-linha { display: flex; align-items: center; gap: 12px; }
