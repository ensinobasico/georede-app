  .encontro-cartao .linha1 .pulso { flex: none; width: 10px; height: 10px; border-radius: 50%; background: var(--azul); animation: piscar 1.2s ease-in-out infinite; }
  .encontro-cartao .linha2 { margin: 2px 0 8px; font-size: 13px; color: var(--tinta-2); }
  .encontro-cartao .acoes { display: flex; flex-wrap: wrap; gap: 6px; }
  .encontro-cartao button { font: inherit; font-size: 13px; font-weight: 600; padding: 7px 12px; margin: 0; cursor: pointer; white-space: nowrap;
    color: var(--tinta); background: var(--painel); border: 1px solid var(--linha); border-radius: 8px; }
  .encontro-cartao button.principal { color: #fff; background: var(--azul); border-color: var(--azul); }
