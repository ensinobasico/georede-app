  // Bluetooth) e volta ao Geo que estava ligado antes, se havia um.
  await adicionarLimpar(false);
  try { await atualizar(); } catch (e) { /* o mapa atualiza-se sozinho */ }
  while (adic.passo === "farol_wifi") {
    await radioEsperar(ADIC.FAROL_VER_MS);
    if (adic.passo !== "farol_wifi") return;
    let v;
    try { v = await obter("/api/geos/adicionar?token=" + encodeURIComponent(adic.token)); } catch (e) { continue; }
    if (adic.passo !== "farol_wifi") return;
    if (v && v.ligado) { adic.passo = "farol_ligado"; adicionarDesenhar(); try { await atualizar(); } catch (e) { /* nada */ } return; }
    if (v && v.espera_acabou) { adic.passo = "farol_tarde"; adicionarDesenhar(); return; }
  }
}
