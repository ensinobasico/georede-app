  .dobra-corpo { padding: 0 14px 14px; }
  .dobra-corpo > .dica:first-child { margin-top: 0; }
  .legal-mais { margin-top: 4px; }

  /* 3.4 / 4.x A tua rede: uma linha por Geo e o ecrã do Geo */
  #vista-aparelhos .lista { border-top: 0; }
  .aparelho-linha { display: block; padding: 0; }
  .lista button.geo-linha { display: flex; align-items: center; gap: 12px; padding: 10px; min-height: 64px; }
  .geo-avatar { flex: none; width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; background: var(--cor, #556171); }
  .geo-avatar svg { width: 24px; height: 24px; }
  .geo-avatar.grande { width: 72px; height: 72px; }
  .geo-avatar.grande svg { width: 40px; height: 40px; }
  .geo-txt { flex: 1; min-width: 0; display: grid; gap: 2px; }
  .geo-txt .detalhe { grid-column: auto; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 6px; }
  .aviso-cab button { text-decoration: none; padding: 4px 12px; border: 1px solid var(--linha); border-radius: 14px; background: var(--painel); }
  .geo-txt .detalhe .bateria { margin-right: 2px; }
  .geo-ecra { padding: 0 16px 20px; }
  .geo-cab { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 4px 0 16px; text-align: center; }
  .geo-cab .nome-btn.geo-nome { margin: 4px 0 0; font-size: 22px; font-weight: 700; }
  .geo-cab .nome-btn.geo-nome .nome { font-size: 22px; }
  .geo-cab .nome-form { width: 100%; }
  .geo-id { font-size: 13px; color: var(--tinta-2); font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .geo-blocos { display: grid; grid-template-columns: repeat(auto-fit, minmax(90px, 1fr)); gap: 8px; }
  .geo-bloco { padding: 10px 12px; border-radius: 12px; background: var(--nevoa); border: 1px solid var(--linha); display: grid; gap: 4px; min-width: 0; }
  .geo-bloco .rotulo { font-size: 12px; color: var(--tinta-2); }
  .geo-bloco b, .geo-bloco .bateria { font-size: 15px; font-weight: 700; color: var(--tinta); margin: 0; }
  .geo-bloco .bateria.baixa { color: var(--ambar); } .geo-bloco .bateria.fraca { color: var(--erro); }
  .geo-acoes { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 8px; margin-top: 14px; }
  .geo-acoes .botao { padding: 12px 14px; border-radius: 12px; font-size: 15px; }
  .geo-menu { margin-top: 14px; border-radius: 14px; border: 1px solid var(--linha); background: var(--nevoa); overflow: hidden; }
  .geo-menu-linha { width: 100%; display: flex; align-items: center; gap: 12px; min-height: 54px; padding: 8px 14px; cursor: pointer; text-align: left;
    font: inherit; font-size: 15px; font-weight: 600; color: var(--tinta); background: none; border: 0; }
  .geo-menu-linha + .geo-menu-linha { border-top: 1px solid var(--linha); }
  .geo-menu-linha:hover { background: color-mix(in srgb, var(--tinta) 5%, transparent); }
  .geo-menu-txt { flex: 1; min-width: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
  .geo-menu.perigo { margin-top: 0; }
  .geo-menu.perigo .perdido { color: var(--ambar); }
  .geo-menu.perigo .libertar { color: #B42318; }
  @media (prefers-color-scheme: dark) { .geo-menu.perigo .libertar { color: #FDA29B; } }
  .geo-ecra .rotulo-grupo { margin: 22px 2px 8px; }
  .geo-ecra .confirmar-caixa { margin-top: 10px; padding: 14px; border: 1px solid var(--linha); border-radius: 12px; background: var(--nevoa); }
  .geo-ecra .confirmar-caixa p { margin: 0 0 12px; font-size: 14px; }
  .geo-ecra .confirmar-caixa .botoes { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 0; }
  .geo-ecra .confirmar-caixa .botao { margin: 0; padding: 11px 14px; border-radius: 10px; }
  .adicionar-entrada { margin-top: 10px; }

  /* 5.x Sinal numa linha quando está tudo bem; Rotas em cartões com o desenho do percurso */
  .sinal-bloco.tudo-bem { align-items: center; }
  .sinal-bloco.tudo-bem .sinal-ponto { width: 22px; height: 22px; margin: 0; display: grid; place-items: center; }
  .sinal-bloco.tudo-bem .sinal-ponto::after { content: ""; width: 9px; height: 5px; margin-top: -2px; border: solid #fff; border-width: 0 0 2.4px 2.4px; transform: rotate(-45deg); }
  .rotas-cartoes { border-top: 0; padding: 4px 12px 8px; }
  .rotas-cartoes > li { position: relative; margin-bottom: 10px; border: 1px solid var(--linha); border-radius: 14px; background: var(--nevoa); overflow: hidden; }
  .rotas-cartoes > li.aberta { box-shadow: inset 3px 0 0 var(--azul); }
  .rotas-cartoes .rota-cartao > button.abrir { grid-template-columns: 96px 1fr auto; padding: 10px 44px 10px 10px; gap: 2px 12px; border-radius: 0; }
  .rotas-cartoes .rota-ico { display: none; }
  .rota-fig { grid-row: 1 / 3; width: 96px; height: 58px; border-radius: 10px; background: color-mix(in srgb, var(--azul) 6%, var(--painel)); border: 1px solid var(--linha); overflow: hidden; }
  .rota-fig svg { width: 100%; height: 100%; display: block; }
  .rota-fig path { fill: none; stroke: var(--azul); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .rota-fig circle { fill: var(--verde); }
  @media (prefers-color-scheme: dark) { .rota-fig path { stroke: var(--foco); } }
  .rotas-cartoes .rota-cartao > .nome-form { padding: 10px; }
  .rota-menu-btn { position: absolute; top: 8px; right: 6px; }
  .rotas-cartoes .rota-acoes { display: grid; gap: 0; margin: 0; padding: 0; border-top: 1px solid var(--linha); background: var(--painel); }
  .lista .rotas-cartoes .rota-acoes button, .rotas-cartoes .rota-acoes button {
    display: block; width: 100%; padding: 13px 14px; text-align: left; font: inherit; font-size: 15px; text-decoration: none;
    color: var(--tinta); background: none; border: 0; border-radius: 0; cursor: pointer;
  }
  .rotas-cartoes .rota-acoes button + button { border-top: 1px solid var(--linha); }
  .rotas-cartoes .rota-acoes button.perigo { color: #B42318; }
  @media (prefers-color-scheme: dark) { .rotas-cartoes .rota-acoes button { color: var(--tinta); } .rotas-cartoes .rota-acoes button.perigo { color: #FDA29B; } }
  .rotas-cartoes .confirmar-caixa { margin: 0; border-radius: 0; border-width: 1px 0 0; }
  .rotas-guardar-dica { margin-top: 4px; text-align: center; }
  .rotas-cartoes .nome { white-space: normal; }
  #vista-sinal > .lista { flex: none; }
  /* Repetidores da GEOREDE (10/11/2026): só a equipa */
  .rep-cartoes { display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; margin: 0 18px 12px; }
  .rep-cartao { padding: 14px; border: 1px solid var(--linha); border-radius: 12px; background: var(--nevoa); display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; min-width: 0; }
  .rep-cab { display: flex; gap: 10px; align-items: flex-start; min-width: 0; }
  .rep-cab > div { min-width: 0; overflow-wrap: anywhere; }
  .rep-linhas > div { overflow-wrap: anywhere; }
  .rep-cab .sinal-ponto { width: 12px; height: 12px; margin-top: 5px; }
  .rep-cab .nome { display: block; font-weight: 700; font-size: 16px; white-space: normal; overflow: visible; }
  .rep-cab .detalhe { display: block; font-size: 13px; color: var(--tinta-2); }
  .rep-cab .geo-id { margin-left: auto; font-size: 12px; color: var(--tinta-2); white-space: nowrap; }
  .estado-ok > .sinal-ponto { background: var(--verde); }
  .estado-bateria > .sinal-ponto { background: var(--ambar); }
  .estado-sem_sinal > .sinal-ponto { background: #C2410C; }
