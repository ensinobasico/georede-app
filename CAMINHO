    const texto = t("rede.partilha_texto", { url: location.origin, codigo: c.codigo });
    const bt = document.createElement("div"); bt.className = "botoes";
    const part = document.createElement("button"); part.type = "button"; part.textContent = t("rede.partilhar");
    part.addEventListener("click", () => { if (navigator.share) navigator.share({ text: texto }).catch(() => null); else navigator.clipboard.writeText(texto).catch(() => null); });
    const cop = document.createElement("button"); cop.type = "button"; cop.textContent = t("rede.copiar");
    cop.addEventListener("click", async () => { try { await navigator.clipboard.writeText(c.codigo); cop.textContent = t("rede.copiado"); } catch (e) { /* nada */ } });
    bt.append(part, cop);
    div.append(p(t("rede.convite_titulo")), cod, p(t(LOJA_ABERTA ? "rede.convite_explica" : "rede.convite_explica_conv", { data }), "rotulo-secao"), bt);
    div.hidden = false;
    $r("rede-pessoas-texto").textContent = textoPessoas(c);
  } finally { b.disabled = false; }
});
</script>



