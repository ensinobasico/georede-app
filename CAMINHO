async function guardarFicheiro(nome, tipo, texto) {
  const nativo = ficheiroNativo();
  if (nativo) { await nativo.partilhar({ nome, tipo, texto }); return "partilhado"; }
  if (nativo === false) return "sem_suporte";
  const a = document.createElement("a");
  a.href = URL.createObjectURL(new Blob([texto], { type: tipo }));
  a.download = nome;
  document.body.append(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(a.href), 30000);
  return "descarregado";
}
