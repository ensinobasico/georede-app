  @media (prefers-color-scheme: dark) { .enviar { color: #0B1220; background: var(--foco); } }
  /* Voz (13/11/2026): 🎤 ditar ao lado de Enviar; 🔊 ouvir junto às bolhas; «Ler as que chegam» na lista */
  .microfone {
    flex: none; width: 40px; height: 40px; display: grid; place-items: center; cursor: pointer;
    color: var(--azul); background: var(--painel); border: 1px solid var(--linha); border-radius: 50%;
  }
