  @media (max-width: 700px) {
    :root { --nav-largura: 0px; --nav-altura: calc(60px + env(safe-area-inset-bottom)); }
    #mapa { inset: 0 0 var(--nav-altura) 0; }
    .navegacao {
      top: auto; right: 0; bottom: 0; width: auto; height: var(--nav-altura); flex-direction: row;
      border-right: 0; border-top: 1px solid var(--linha); padding-bottom: env(safe-area-inset-bottom);
    }
    .navegacao .marca-nav, .nav-rodape, .navegacao .so-computador, .navegacao .breve { display: none; }
    .navegacao .so-movel { display: block; }
    .navegacao ul { flex-direction: row; padding: 0; gap: 0; }
    .navegacao li { flex: 1; }
    .navegacao a { flex-direction: column; gap: 3px; padding: 8px 2px 6px; font-size: 11px; border-radius: 0; height: 60px; justify-content: center; position: relative; }
    .navegacao a[aria-current="page"] { background: none; }
    .navegacao .rotulo { flex: none; }
    .navegacao .contador { position: absolute; top: 5px; left: calc(50% + 6px); margin: 0; }
    .painel {
      top: auto; left: 0; right: 0; bottom: var(--nav-altura); width: auto; max-height: 46vh;
      border-radius: 16px 16px 0 0; border-bottom: 0;
    }
    .topo { padding-top: 2px; cursor: pointer; -webkit-tap-highlight-color: transparent; }
    .puxador {
      display: block; flex: none; width: 100%; height: 22px; padding: 0; margin: 0;
      background: none; border: 0; cursor: grab; touch-action: none; -webkit-tap-highlight-color: transparent;
    }
    .puxador::before { content: ""; display: block; width: 40px; height: 4px; margin: 10px auto 0; border-radius: 2px; background: var(--linha); }
    .puxador:focus-visible { outline-offset: -4px; }
