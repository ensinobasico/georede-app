  dica.textContent = (f.seguinte ? t("plano.vagas_seguinte", { n: f.vagas, seguinte: f.seguinte }) : t("plano.vagas", { n: f.vagas }))
    + (f.teste ? t("plano.teste_curto") : "");
  dica.hidden = false;
  legal.textContent = t("plano.legal"); legal.hidden = false;
}
