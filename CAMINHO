  /* Pega do painel (só no telemóvel) */
  .puxador { display: none; }

  :focus-visible { outline: 2px solid var(--foco); outline-offset: 2px; }

  /* Marcador no mapa: figurinha do perfil (pata, pessoa, seta, bicicleta, ...) num círculo com a cor da frescura,
     o nome sempre por cima e um anel que mostra a frescura da posição. O mapa (OSM) é sempre claro. */
  .marcador { position: relative; width: 30px; height: 30px; cursor: pointer; }
  .marcador .fig {
    position: absolute; inset: 0; border-radius: 50%; display: grid; place-items: center;
    background: var(--cor); border: 2.5px solid #fff; box-shadow: 0 1px 4px rgba(0,0,0,.4); z-index: 1;
  }
  .marcador .fig svg { width: 19px; height: 19px; display: block; }
  .marcador .nome {
    position: absolute; bottom: calc(100% + 5px); left: 50%; transform: translateX(-50%);
    max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    padding: 1px 7px; border-radius: 999px; background: rgba(255,255,255,.94); color: #1C2430;
    font: 600 12px/1.45 system-ui, sans-serif; box-shadow: 0 1px 3px rgba(0,0,0,.3); pointer-events: none;
  }
  .marcador.selecionado .nome { background: #1C2430; color: #fff; }
  .marcador::after {
    content: ""; position: absolute; inset: -8px; border-radius: 50%;
    border: 2px solid var(--cor); opacity: .35;
  }
  .marcador.selecionado { z-index: 5; }
  .marcador.selecionado::after { opacity: .8; }
  .marcador.fresco::after { animation: onda 2.4s ease-out infinite; }
  @keyframes onda { from { transform: scale(.6); opacity: .7; } to { transform: scale(1.6); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .marcador.fresco::after { animation: none; } }

  /* Modo Procurar: faixa no painel, botão na barra do trajeto e marcador a pulsar */
  :root { --procura: #C2410C; }
  @media (prefers-color-scheme: dark) { :root { --procura: #FB923C; } }
  .procuras { display: grid; gap: 8px; margin: 0 12px 10px; }
  .procuras[hidden] { display: none; }
  .procura-cartao {
    padding: 10px 12px; border-radius: 12px; border: 1.5px solid var(--procura);
    background: color-mix(in srgb, var(--procura) 9%, var(--painel));
  }
  .procura-cartao .linha1 { display: flex; align-items: center; gap: 8px; font-weight: 700; color: var(--procura); }
  .procura-cartao .pulso { flex: none; width: 10px; height: 10px; border-radius: 50%; background: var(--procura); animation: piscar 1.2s ease-in-out infinite; }
  .procura-cartao .linha2 { margin: 2px 0 8px; font-size: 13px; color: var(--tinta-2); }
  .procura-cartao .acoes { display: grid; grid-template-columns: 1fr auto auto; gap: 6px; padding: 0; margin: 0; }
  .procura-cartao button {
    font: inherit; font-size: 13px; font-weight: 600; padding: 7px 12px; margin: 0; cursor: pointer; white-space: nowrap;
    color: var(--tinta); background: var(--painel); border: 1px solid var(--linha); border-radius: 8px;
  }
  .procura-cartao button.principal { color: #fff; background: var(--procura); border-color: var(--procura); }
  @media (prefers-color-scheme: dark) { .procura-cartao button.principal { color: #0B1220; } }
  .procura-cartao button:disabled { opacity: .6; cursor: default; }
  /* «Vamos encontrar-nos» */
