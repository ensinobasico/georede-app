function frescura(hora) {
  if (!hora) return "sem";
  const min = (Date.now() - new Date(hora).getTime()) / 60000;
  return min < 15 ? "fresco" : min < 120 ? "recente" : "antigo";
}
// "há 5 min", "há 2 h", "há 3 dias"
function quando(hora) {
  if (!hora) return "";
  const s = Math.max(0, (Date.now() - new Date(hora).getTime()) / 1000);
  if (s < 60) return t("tempo.agora");
  if (s < 3600) return t("tempo.min", { n: Math.round(s / 60) });
  if (s < 86400) return t("tempo.horas", { n: Math.round(s / 3600) });
  return t("tempo.dias", { n: Math.round(s / 86400) });
}
function ha(hora) {
  return hora ? t("visto", { quando: quando(hora) }) : t("sem_posicoes_ainda");
