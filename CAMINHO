// O dono imprime o QR para a coleira. Quem encontrar abre a página pública /api/e/<código> e manda a sua posição.
"use strict";
const achado = { a: null, dados: null };
const $q = id => document.getElementById(id);
async function achadoAbrir(a) {
  achado.a = a; achado.dados = null;
  $q("achado-titulo").textContent = t("achado.titulo", { nome: a.nome });
  $q("achado").hidden = false;
  achadoDesenhar(t("achado.a_carregar"));
