async function carregarMensagens({ inicio = false, antigas = false } = {}) {
  const m = estado.msg, k = m.aberta;
  if (k === null || m.aCarregar) return;
  m.aCarregar = true;
  try {
    const ids = [...m.itens.values()].filter(x => !x.radio).map(x => x.id);   // as da rádio não são do servidor
    const antes = antigas && ids.length ? Math.min(...ids) : null;
    let r;
    try {
      if (k === SUPORTE) r = await suporteMensagens(inicio);
      else if (conversaSoRadio(k)) r = { mensagens: [], mais: false, modo: m.modo };       // só existem na rádio: nada no servidor
      else r = await obter(`/api/mensagens?conversa=${encodeURIComponent(k)}` + (antes ? `&antes=${antes}` : ""));
    }
    catch (e) {
      if (!(semInternet(e) && (radioAtivo() || radio.mensagens.length))) throw e;
      r = { mensagens: [], mais: false, modo: m.modo };   // sem internet: só as mensagens da rádio
    }
    if (m.aberta !== k) return;             // entretanto mudou de conversa
    for (const x of radioItensConversa(k)) if (!m.itens.has(x.id)) m.itens.set(x.id, x);
    if (inicio || antigas) m.mais = r.mais;
    else if (!ids.length) m.mais = r.mais;
    const lista = document.getElementById("bolhas");
    const noFundo = lista.scrollHeight - lista.scrollTop - lista.clientHeight < 60;
    const alturaAntes = lista.scrollHeight;
    for (const x of r.mensagens) {
      if (!inicio && !antigas && !m.itens.has(x.id)) m.novas.add(x.id);
      m.itens.set(x.id, x);
    }
    for (const id of radioJuntarEcos(m.itens)) m.ecosLidos = Math.max(m.ecosLidos || 0, id);
    m.modo = r.modo;
    desenharModo();
    desenharMensagens();
    if (antigas) lista.scrollTop = lista.scrollHeight - alturaAntes;
    else if (inicio || noFundo) lista.scrollTop = lista.scrollHeight;
    marcarLidas();
  } catch (e) {
    if (String(e.message).endsWith(": 404")) { fecharConversa("substituir"); history.replaceState({ v: "mensagens" }, "", "/mensagens"); }
    else throw e;
  } finally { m.aCarregar = false; }
}
async function marcarLidas() {
  const m = estado.msg, k = m.aberta;
  if (k === null || k === SUPORTE || conversaSoRadio(k) || document.hidden) return;
  const ate = Math.max(0, m.ecosLidos || 0, ...[...m.itens.values()].filter(x => !x.de.tu && !x.radio).map(x => x.id));
  if (!ate || (m.lidaAte[k] || 0) >= ate) return;
  m.lidaAte[k] = ate;
  try {
    await enviar("/api/mensagens/lidas", { conversa: k, ate });
    const c = conversaPorChave(k);
    if (c && c.nao_lidas) { m.naoLidas = Math.max(0, m.naoLidas - c.nao_lidas); c.nao_lidas = 0; atualizarContadorMsg(); }
  } catch (e) { m.lidaAte[k] = 0; }
}
function rodapeEstado(x) {
