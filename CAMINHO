  .plano-texto b { font-size: 16px; }
  .plano-texto .dica { margin: 0; font-size: 13px; }
  .plano-linha .botao { flex: none; padding: 10px 16px; border-radius: 10px; }
  .plano-legal { margin: 0; font-size: 12px; color: var(--tinta-2); }
  /* 09/11 (telemóvel, letra do Android a 115 %): a coluna da grelha alargava-se ao conteúdo e o cartão passava a
     margem direita («Aderir», «Usar» e o texto legal cortados). A coluna fica sempre dentro do cartão; o texto
     quebra; com pouco espaço, «Aderir» passa para baixo do texto. */
  .rede-plano { grid-template-columns: minmax(0, 1fr); }
  .rede-plano > * { min-width: 0; }
  .rede-plano p, .rede-plano summary, .plano-texto b { overflow-wrap: anywhere; }
