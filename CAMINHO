    if (!r.ok) { mensagem("rede-msg", r.corpo.erro || t("erro.pedido"), true); return; }
    $r("rede-nome").value = ""; mensagem("rede-msg", "", false);
    estado.conta = null; estado.primeiraVez = true;
    await atualizar();
    try { mudarVista("aparelhos"); } catch (e) { /* fica no mapa */ }
    if (estado.entradaComGeos) setTimeout(() => { try { adicionarAbrir(); } catch (e) { /* fica na lista */ } }, 150);
  } catch (e) {
    if (e.message !== "sessão expirada") mensagem("rede-msg", t("erro.sem_ligacao"), true);
  } finally { b.disabled = false; }
});
function textoPessoas(o) {
  return o.limite == null ? t("rede.pessoas_sem_limite", { pessoas: o.pessoas, n: o.pessoas }) : t("rede.pessoas", o);
}
