  @keyframes voz-pulsar { 0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--erro) 45%, transparent); } 50% { box-shadow: 0 0 0 7px transparent; } }
  @media (prefers-reduced-motion: reduce) { .microfone.a-ouvir { animation: none; } }
