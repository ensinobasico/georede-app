// ================= Sinal (Mais → Sinal, 08/11/2026) =================
// Resumo em linguagem simples para todos; os números (ChUtil, AirUtilTX, SNR, RSSI, saltos, vizinhos) em «Detalhes
// técnicos». Os dados vêm de GET /api/sinal (sinal.py), só da rede da própria conta.
const sinalEstado = { dados: null, tecnico: false, hora: null };
const numFmt1 = new Intl.NumberFormat(LOCALE, { maximumFractionDigits: 1 });
function sinalNum(v) { return v == null ? "?" : numFmt1.format(v).replace("-", "−"); }
function sinalEl(tag, cls, texto) {
  const e = document.createElement(tag);
  if (cls) e.className = cls;
  if (texto != null) e.textContent = texto;
  return e;
}
async function abrirSinal() {
  desenharSinal();
  try {
    sinalEstado.dados = await obter("/api/sinal");
    sinalEstado.hora = new Date().toISOString();
    mensagem("sinal-msg", "", false);
  } catch (e) {
    if (e.message !== "sessão expirada") mensagem("sinal-msg", t("erro.sem_ligacao"), true);
  }
  desenharSinal();
}
function sinalBloco(id, estadoTxt, titulo, texto) {
  const b = document.getElementById(id);
  b.className = "sinal-bloco estado-" + estadoTxt;
  b.querySelector("b").textContent = titulo;
  b.querySelector("p").textContent = texto;
}
// a receção mais recente que conta (recente e direta), ou a mais recente com saltos
function sinalRececao(g) {
  const recentes = (g.ouvido_por || []).filter(o => o.recente);
  return recentes.find(o => o.direto && o.sinal) || recentes[0] || null;
}
function sinalDetalheSimples(g) {
  const partes = [];
  const fixo = PERFIS_FIXOS.includes(g.perfil);
  if (g.canal && g.canal.recente && g.canal.estado) partes.push(t("sinal.a_volta", { estado: t("sinal.estado_rede." + g.canal.estado) }));
  const o = sinalRececao(g);
  if (o && o.direto && o.sinal) partes.push(t("sinal.estado." + o.sinal) + " · " + t("sinal.ouvido", { por: o.por || t("sinal.outro"), quando: quando(o.hora) }));
  else if (o) partes.push(t("sinal.ouvido_saltos", { quando: quando(o.hora) }));
  else if (!fixo) partes.push(t("sinal.nunca_ouvido"));
  return partes.join(" · ");
}
function desenharSinal() {
  const d = sinalEstado.dados;
  const lista = document.getElementById("sinal-geos");
  lista.replaceChildren();
  const botao = document.getElementById("sinal-tecnico-botao");
  botao.setAttribute("aria-expanded", String(sinalEstado.tecnico));
  botao.textContent = t(sinalEstado.tecnico ? "sinal.tecnico_fechar" : "sinal.tecnico");
  document.getElementById("sinal-tecnico").hidden = !sinalEstado.tecnico || !d;
  document.getElementById("sinal-hora").textContent = sinalEstado.hora ? t("sinal.atualizado", { quando: quando(sinalEstado.hora) }) : "";
  if (!d) {
    sinalBloco("sinal-rede", "sem_dados", t("sinal.a_carregar"), "");
    sinalBloco("sinal-sinal", "sem_dados", "", "");
    document.getElementById("sinal-sinal").hidden = true;
    document.getElementById("sinal-emissao").hidden = true;
    return;
  }
  document.getElementById("sinal-sinal").hidden = false;
  const r = d.resumo;
  // o Geo que puxa a rede para cima (o de maior ocupação recente)
  const cheio = d.geos.filter(g => g.canal && g.canal.recente && g.canal.ocupacao != null)
    .sort((a, b) => b.canal.ocupacao - a.canal.ocupacao)[0];
  if (!d.geos.length) {
    sinalBloco("sinal-rede", "sem_dados", t("sinal.rede.sem_dados"), t("sinal.sem_geos"));
    document.getElementById("sinal-sinal").hidden = true;
  } else if (r.rede === "calma" && r.sinal === "bom" && !r.emissao_alta.length) {
    // Revisão da UI (09/11): com tudo bem, uma só linha; os dois cartões só aparecem quando há alguma coisa a dizer
    sinalBloco("sinal-rede", "bom", t("sinal.tudo_bem"), t("sinal.tudo_bem_txt"));
    document.getElementById("sinal-rede").classList.add("tudo-bem");
    document.getElementById("sinal-sinal").hidden = true;
  } else {
    sinalBloco("sinal-rede", r.rede, t("sinal.rede." + r.rede), t("sinal.rede." + r.rede + "_txt", { geo: cheio ? cheio.nome : "" }));
    sinalBloco("sinal-sinal", r.sinal, t("sinal.sinal." + r.sinal), t("sinal.sinal." + r.sinal + "_txt", { geos: r.geos_fracos.join(", ") }));
  }
  const em = document.getElementById("sinal-emissao");
  em.hidden = !r.emissao_alta.length;
  em.textContent = r.emissao_alta.length ? t("sinal.emissao", { geos: r.emissao_alta.join(", ") }) : "";

  for (const g of d.geos) {
    const li = sinalEl("li", "sinal-geo estado-" + (g.sinal || (g.canal && g.canal.recente && g.canal.estado) || "sem_dados"));
    li.append(sinalEl("span", "sinal-ponto"));
    const txt = sinalEl("div");
    txt.append(sinalEl("span", "nome", g.nome), sinalEl("span", "detalhe", sinalDetalheSimples(g)));
    li.append(txt);
    lista.append(li);
  }
  if (sinalEstado.tecnico) desenharSinalTecnico(d);
}
function desenharSinalTecnico(d) {
  const caixa = document.getElementById("sinal-tecnico");
  caixa.replaceChildren();
  const linha = (dl, rotulo, valores) => {
    dl.append(sinalEl("dt", null, rotulo));
    const dd = sinalEl("dd");
    for (const v of [].concat(valores)) dd.append(sinalEl("span", null, v));
    dl.append(dd);
  };
  const comHora = (v, hora, recente) => recente === false ? t("sinal.t.antiga", { v, quando: quando(hora) }) : `${v} · ${quando(hora)}`;
  let algumVizinho = false;
  for (const g of d.geos) {
    const c = sinalEl("div", "cartao");
    c.append(sinalEl("h3", null, `${g.nome} · ${g.id}`));
    const dl = sinalEl("dl");
    if (g.canal) {
      linha(dl, t("sinal.t.ocupacao"), g.canal.ocupacao == null ? t("sinal.t.sem") : comHora(sinalNum(g.canal.ocupacao) + "%", g.canal.hora, g.canal.recente));
      linha(dl, t("sinal.t.emissao"), g.canal.emissao == null ? t("sinal.t.sem") : t("sinal.t.emissao_valor", { v: sinalNum(g.canal.emissao) + "%" }));
    } else {
      linha(dl, t("sinal.t.ocupacao"), t("sinal.t.sem"));
    }
    if (g.ouvido_por.length) {
      linha(dl, t("sinal.t.ouvido"), g.ouvido_por.map(o => t("sinal.t.recepcao", {
        por: o.por || o.gateway, snr: sinalNum(o.snr), rssi: sinalNum(o.rssi),
        saltos: o.saltos === 0 ? t("sinal.t.direto") : o.saltos == null ? "?" : t("sinal.t.saltos", { n: o.saltos }),
        quando: quando(o.hora) })));
    } else if (!PERFIS_FIXOS.includes(g.perfil)) {
      linha(dl, t("sinal.t.ouvido"), t("sinal.pelo_telemovel"));
    }
    if (g.vizinhos) {
      algumVizinho = true;
      const v = g.vizinhos;
      const partes = v.rede.map(x => t("sinal.t.vizinho", { nome: x.nome || x.id, snr: sinalNum(x.snr) }));
      if (v.outros) {
        const o = t("sinal.t.outros", { n: v.outros });
        partes.push(v.outros_snr != null ? t("sinal.t.outros_snr", { txt: o, snr: sinalNum(v.outros_snr) }) : o);
      }
      linha(dl, t("sinal.t.vizinhos"), [partes.length ? partes.join(", ") : t("sinal.t.ninguem"), comHora("", v.hora, v.recente).replace(/^ · /, "")]);
    }
    if (g.local) {
      linha(dl, t("sinal.t.local"), t("sinal.t.local_valor", { alcance: g.local.ao_alcance ?? "?", rx: g.local.recebidos ?? "?",
                                                                maus: g.local.com_erro ?? "?", dup: g.local.repetidos ?? "?" }));
    }
    c.append(dl);
    caixa.append(c);
  }
  if (d.geos.length && !algumVizinho) caixa.append(sinalEl("p", "dica", t("sinal.t.sem_vizinhos")));
  const gl = sinalEl("div", "cartao glossario");
  gl.append(sinalEl("h3", null, t("sinal.t.glossario")));
  for (const k of ["g_ocupacao", "g_emissao", "g_snr", "g_rssi", "g_saltos"]) gl.append(sinalEl("p", null, t("sinal.t." + k)));
  caixa.append(gl);
}
