<script>
// ===== GEOREDE — mapa sem internet (passo 3) =====
// O mapa vem do nosso servidor (mosaicos vetoriais do Protomaps em /mapa/tiles, letras e ícones em /mapa/...).
// "Guardar o mapa" descarrega para este telemóvel a zona à volta de casa (25 km, com detalhe de rua nos
// últimos 8 km) e das zonas da família, e o sw.js serve-a quando não há rede.
// A zona guardada mostra onde fica a casa: apaga-se ao sair da conta.
"use strict";
const MAPA = {
  CACHE: "georede-mapa", META: "georede-mapa",
  RAIO_KM: 25, RAIO_RUA_KM: 8, ZOOM_RUA: 15, ZOOM_ZONA: 14, ZOOM_PAIS: 9,
  // vista do país (até ao zoom 9): a península até ao zoom 7 e, até ao 9, o país onde fica a casa
  // (as ilhas entram pela zona guardada à volta de casa)
  PENINSULA: { oeste: -9.75, sul: 35.9, este: 4.45, norte: 43.95 }, ZOOM_PENINSULA: 7,
  PAISES: [
    { nome: "pt", oeste: -9.75, sul: 36.8, este: -6.0, norte: 42.25, dentro: (lat, lon) => lon < -6.2 && lat > 36.9 && lat < 42.15 && !(lat > 41.85 && lon > -8.2) },
    { nome: "es", oeste: -9.4, sul: 35.9, este: 4.45, norte: 43.95, dentro: () => true }
  ],
  FONTES: ["Noto Sans Regular", "Noto Sans Medium", "Noto Sans Italic"],
  INTERVALOS: ["0-255", "256-511", "8192-8447"],                     // latim, acentos e pontuação
  PARALELO: 6, KB_MEDIO: 30,
  // a Europa toda até ao zoom 5 (para ver onde se está); fora de Portugal e Espanha, 200 km à volta de casa até ao 9
  EUROPA: { oeste: -31.5, sul: 27.5, este: 40.5, norte: 71.5 }, ZOOM_EUROPA: 5, RAIO_REGIAO_KM: 200
};
const mapaOff = { aGuardar: false, cancelar: false, feitos: 0, total: 0, bytes: 0, versaoServidor: null };

// Até ao zoom 14 vem do mapa da Europa; o 15 só existe no detalhe (Portugal e Espanha)
function urlMosaico(z, x, y) { return `/mapa/tiles/${Number(z) >= MAPA_DETALHE_ZOOM ? "detalhe" : "georede"}/${z}/${x}/${y}.mvt`; }

// ---- contas dos mosaicos (Web Mercator)
function mosX(lon, z) { return Math.floor((lon + 180) / 360 * 2 ** z); }
function mosY(lat, z) { const r = lat * Math.PI / 180; return Math.floor((1 - Math.asinh(Math.tan(r)) / Math.PI) / 2 * 2 ** z); }
function mosLon(x, z) { return x / 2 ** z * 360 - 180; }
function mosLat(y, z) { const n = Math.PI - 2 * Math.PI * y / 2 ** z; return 180 / Math.PI * Math.atan(Math.sinh(n)); }
function distKm(lat1, lon1, lat2, lon2) {
  const r = Math.PI / 180, a = Math.sin((lat2 - lat1) * r / 2) ** 2 + Math.cos(lat1 * r) * Math.cos(lat2 * r) * Math.sin((lon2 - lon1) * r / 2) ** 2;
  return 12742 * Math.asin(Math.sqrt(a));
}
function mosaicosCirculo(lat, lon, km, z, conjunto) {
  const dLat = km / 111.2, dLon = km / (111.2 * Math.cos(lat * Math.PI / 180));
  const x0 = mosX(lon - dLon, z), x1 = mosX(lon + dLon, z), y0 = mosY(lat + dLat, z), y1 = mosY(lat - dLat, z);
  for (let x = x0; x <= x1; x++) for (let y = y0; y <= y1; y++) {
    // fica se o ponto do mosaico mais perto do centro estiver dentro do círculo
    const la = Math.min(Math.max(lat, mosLat(y + 1, z)), mosLat(y, z)), lo = Math.min(Math.max(lon, mosLon(x, z)), mosLon(x + 1, z));
    if (distKm(lat, lon, la, lo) <= km) conjunto.add(`${z}/${x}/${y}`);
  }
}
function mosaicosCaixa(c, z, conjunto) {
  for (let x = mosX(c.oeste, z); x <= mosX(c.este, z); x++)
    for (let y = mosY(c.norte, z); y <= mosY(c.sul, z); y++) conjunto.add(`${z}/${x}/${y}`);
}
// Centro da zona a guardar: o Geo Farol (casa), senão a primeira zona da família, senão o centro do mapa
function centroMapa() {
  const casa = estado.aparelhos.find(a => a.perfil === "casa" && a.ultima);
  if (casa) return { lat: casa.ultima.lat, lon: casa.ultima.lon, onde: "casa" };
  const z = (estado.zonas || [])[0];
  if (z) return { lat: z.lat, lon: z.lon, onde: "zona", nome: z.nome };
  const c = mapa.getCenter();
  return { lat: c.lat, lon: c.lng, onde: "mapa" };
}
function paisDe(lat, lon) {                                          // fora da península (ilhas): nenhum
  if (lat < 35.2 || lon < -10 || lon > 4.6 || lat > 44) return null;
  return MAPA.PAISES.find(p => p.dentro(lat, lon));
}
function planoMapa(centro) {
  const s = new Set();
  for (let z = 0; z <= MAPA.ZOOM_EUROPA; z++) mosaicosCaixa(MAPA.EUROPA, z, s);
  const pais = paisDe(centro.lat, centro.lon);
  if (pais) {
    for (let z = MAPA.ZOOM_EUROPA + 1; z <= MAPA.ZOOM_PENINSULA; z++) mosaicosCaixa(MAPA.PENINSULA, z, s);
    for (let z = MAPA.ZOOM_PENINSULA + 1; z <= MAPA.ZOOM_PAIS; z++) mosaicosCaixa(pais, z, s);
  } else {
    for (let z = MAPA.ZOOM_EUROPA + 1; z <= MAPA.ZOOM_PAIS; z++) mosaicosCirculo(centro.lat, centro.lon, MAPA.RAIO_REGIAO_KM, z, s);
  }
  for (let z = MAPA.ZOOM_PAIS + 1; z < MAPA.ZOOM_RUA; z++) mosaicosCirculo(centro.lat, centro.lon, MAPA.RAIO_KM, z, s);
  mosaicosCirculo(centro.lat, centro.lon, MAPA.RAIO_RUA_KM, MAPA.ZOOM_RUA, s);
  for (const zn of estado.zonas || []) {                              // zonas da família: com detalhe de rua
    const km = Math.min(3, (zn.raio || 200) / 1000 + 1);
    for (let z = MAPA.ZOOM_ZONA; z <= MAPA.ZOOM_RUA; z++) mosaicosCirculo(zn.lat, zn.lon, km, z, s);
  }
  // o zoom 15 só onde há detalhe; no resto, o telemóvel amplia o 14 (que já está guardado)
  const urls = [...s].filter(k => {
    const [z, x, y] = k.split("/").map(Number);
    return z < MAPA_DETALHE_ZOOM || temDetalhe(mosLat(y + 0.5, z), mosLon(x + 0.5, z));
  }).map(k => { const [z, x, y] = k.split("/"); return urlMosaico(z, x, y); });
  const extra = [];
  for (const f of MAPA.FONTES) for (const r of MAPA.INTERVALOS) extra.push(`/mapa/fontes/${encodeURIComponent(f)}/${r}.pbf`);
  for (const sabor of ["light", "dark"]) for (const m of ["", "@2x"]) for (const e of [".json", ".png"]) extra.push(`/mapa/sprites/v4/${sabor}${m}${e}`);
  return { urls, extra };
}

// ---- guardar, atualizar, apagar
function metaMapa() { try { return JSON.parse(localStorage.getItem(MAPA.META) || "null"); } catch (e) { return null; } }
function guardarMetaMapa(m) { try { if (m) localStorage.setItem(MAPA.META, JSON.stringify(m)); else localStorage.removeItem(MAPA.META); } catch (e) { /* nada */ } }
async function guardarMapa() {
  if (mapaOff.aGuardar || !("caches" in window)) return;
  if (!navigator.onLine) { mensagem("mapa-msg", t("mapa.sem_rede"), true); return; }
  const centro = centroMapa(), plano = planoMapa(centro);
  const lista = plano.urls.concat(plano.extra);
  Object.assign(mapaOff, { aGuardar: true, cancelar: false, feitos: 0, total: lista.length, bytes: 0, falhas: 0 });
  mensagem("mapa-msg", "", false); desenharMapaOff();
  try { if (navigator.storage && navigator.storage.persist) await navigator.storage.persist(); } catch (e) { /* o navegador decide */ }
  let versao = null;
  try { const r = await fetch("/mapa/versao.json", { cache: "no-store", credentials: "same-origin" }); if (r.ok) versao = (await r.json()).versao; } catch (e) { /* fica sem versão */ }
  await caches.delete(MAPA.CACHE);                                      // atualizar = começar do zero com o mapa novo
  const cache = await caches.open(MAPA.CACHE);
  let i = 0, sessao = true;
  const trabalhador = async () => {
    while (i < lista.length && !mapaOff.cancelar && sessao) {
      const u = lista[i++];
      try {
        const r = await fetch(u, { credentials: "same-origin", cache: "no-store" });
        const tipo = r.headers.get("Content-Type") || "";
        if (r.redirected || tipo.includes("text/html")) { sessao = false; break; }   // sessão terminada: parar
        if (r.ok) { const b = await r.clone().arrayBuffer(); mapaOff.bytes += b.byteLength; await cache.put(u, r); }
        else if (r.status !== 404) mapaOff.falhas++;                 // 404 = mar ou fora do mapa: normal
      } catch (e) { mapaOff.falhas++; }
      mapaOff.feitos++;
      if (mapaOff.feitos % 20 === 0) desenharMapaOff();
    }
  };
  await Promise.all(Array.from({ length: MAPA.PARALELO }, trabalhador));
  const ok = !mapaOff.cancelar && sessao && mapaOff.falhas < lista.length * 0.05;
  if (ok) guardarMetaMapa({ versao, data: new Date().toISOString(), centro, n: mapaOff.feitos, bytes: mapaOff.bytes, km: MAPA.RAIO_KM });
  else { await caches.delete(MAPA.CACHE); guardarMetaMapa(null); }
  mapaOff.aGuardar = false;
  if (!sessao) mensagem("mapa-msg", t("mapa.sessao"), true);
  else if (mapaOff.cancelar) mensagem("mapa-msg", t("mapa.cancelado"), false);
  else if (!ok) mensagem("mapa-msg", t("mapa.falhou"), true);
  else { mensagem("mapa-msg", t("mapa.guardado_ok", { mb: (mapaOff.bytes / 1e6).toFixed(0) }), false); mapaOff.versaoServidor = versao; }
  desenharMapaOff();
}
async function apagarMapa() {
  mapaOff.cancelar = true;
  try { await caches.delete(MAPA.CACHE); } catch (e) { /* nada */ }
  guardarMetaMapa(null); mensagem("mapa-msg", "", false); desenharMapaOff();
}
async function verVersaoMapa() {
  if (!mapaProprio() || !navigator.onLine) return;
  try {
    const r = await fetch("/mapa/versao.json", { cache: "no-store", credentials: "same-origin" });
    if (r.ok && (r.headers.get("Content-Type") || "").includes("json")) { mapaOff.versaoServidor = (await r.json()).versao; desenharMapaOff(); }
  } catch (e) { /* sem rede */ }
}
function desenharMapaOff() {
  const cartao = document.getElementById("mapa-cartao");
  if (!cartao) return;
  cartao.hidden = !mapaProprio() || !("caches" in window);
  if (cartao.hidden) return;
  const m = metaMapa(), est = document.getElementById("mapa-estado"), barra = document.getElementById("mapa-barra");
  const bGuardar = document.getElementById("mapa-guardar"), bApagar = document.getElementById("mapa-apagar");
  barra.hidden = !mapaOff.aGuardar;
  if (mapaOff.aGuardar) {
    const p = mapaOff.total ? Math.round(100 * mapaOff.feitos / mapaOff.total) : 0;
    barra.querySelector("span").style.width = p + "%";
    est.textContent = t("mapa.a_guardar", { feitos: mapaOff.feitos, total: mapaOff.total, mb: (mapaOff.bytes / 1e6).toFixed(1) });
    bGuardar.hidden = true; bApagar.hidden = false; bApagar.textContent = t("comum.cancelar");
    return;
  }
  bApagar.textContent = t("mapa.apagar");
  if (m) {
    const onde = m.centro.onde === "casa" ? t("mapa.onde_casa") : m.centro.onde === "zona" ? t("mapa.onde_zona", { nome: m.centro.nome || "" }) : t("mapa.onde_mapa");
    est.textContent = t("mapa.guardado", { km: m.km, onde, quando: quando(m.data), mb: (m.bytes / 1e6).toFixed(0) });
    const novo = mapaOff.versaoServidor && m.versao && mapaOff.versaoServidor !== m.versao;
    bGuardar.hidden = false; bGuardar.textContent = novo ? t("mapa.atualizar_novo") : t("mapa.atualizar");
    bApagar.hidden = false;
  } else {
    const c = centroMapa(), n = planoMapa(c);
    const total = n.urls.length + n.extra.length;
    const onde = c.onde === "casa" ? t("mapa.onde_casa") : c.onde === "zona" ? t("mapa.onde_zona", { nome: c.nome || "" }) : t("mapa.onde_mapa");
    est.textContent = t("mapa.por_guardar", { km: MAPA.RAIO_KM, onde, mb: Math.max(5, Math.round(total * MAPA.KB_MEDIO / 1000)) });
    bGuardar.hidden = false; bGuardar.textContent = t("mapa.guardar"); bApagar.hidden = true;
  }
}
document.getElementById("mapa-guardar").addEventListener("click", () => guardarMapa());
document.getElementById("mapa-apagar").addEventListener("click", () => apagarMapa());
// Sair da conta: a zona guardada mostra onde fica a casa, por isso vai com a conta
document.querySelectorAll('form[action="/auth/logout"]').forEach(f => f.addEventListener("submit", () => {
  try { caches.delete(MAPA.CACHE); } catch (e) { /* nada */ }
  guardarMetaMapa(null);
}));
window.addEventListener("online", verVersaoMapa);
window.addEventListener("online", () => { if (radioAtivo()) ponteAgendar(200); });
desenharMapaOff();
verVersaoMapa();

// ---- depois de "Sair": ecrã "Saíste da conta" por cima de tudo (ao abrir e ao voltar atrás),
// com a saída de emergência: usar só o Geo por Bluetooth, sem guardar nada (decidido a 04/11/2026)
function mostrarSaiu() {
