const regiaoValida = r => REGIAO.CURTAS.includes(r) || r in REGIAO.OUTRAS;
function regiaoNome(r) {
  if (!r) return "";
  if (REGIAO.CURTAS.includes(r) || r === "EU_433") return t("regiao." + r);
  const o = REGIAO.OUTRAS[r]; if (!o) return r;
  let pais = o[0];
  try { pais = new Intl.DisplayNames([LOCALE], { type: "region" }).of(o[0]) || o[0]; } catch (e) { /* fica o código */ }
  return `${pais} (${o[1]})`;
}
// O que o Geo tem agora (o último campo region do LoRaConfig ganha, como no protobuf)
function adicionarRegiaoDoGeo() {
  const lo = adic.radio && adic.radio.config[REGIAO.LORA];
  if (!lo) return null;
  try {
    const c = pbCampos(lo).filter(x => x.num === REGIAO.CAMPO && x.fio === 0).pop();
    const r = c ? REGIAO.NUM[Number(c.valor)] : "UNSET";
    return r && regiaoValida(r) ? r : null;
  } catch (e) { return null; }
}
// Sugestão pelo fuso horário e, se não chegar, pela língua do telemóvel (en-US, pt-BR…). null = não sei.
function regiaoSugerida() {
  let fuso = "";
  try { fuso = Intl.DateTimeFormat().resolvedOptions().timeZone || ""; } catch (e) { /* nada */ }
  if (REGIAO.FUSOS[fuso]) return REGIAO.FUSOS[fuso];
  if (/^Europe\//.test(fuso) || /^Atlantic\/(Azores|Madeira|Canary|Faroe|Reykjavik)$/.test(fuso)) return "EU_868";
  if (/^America\//.test(fuso)) return REGIAO.BRASIL_FUSOS.split(" ").includes(fuso.split("/").pop()) ? "BR_902" : "US";
  if (/^Australia\//.test(fuso)) return "ANZ";
  for (const l of (navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ""])) {
    const pais = (String(l).split("-")[1] || "").toUpperCase();
    if (REGIAO.PAIS[pais]) return REGIAO.PAIS[pais];
    if (pais && REGIAO.EUROPA.split(" ").includes(pais)) return "EU_868";
  }
  return null;
}
function adicionarRegiao() {
  adic.regiaoGeo = adicionarRegiaoDoGeo();
  adic.regiao = adic.regiaoGeo || (regiaoValida(adic.regiao) ? adic.regiao : regiaoSugerida());
  adic.regiaoConfirmada = false; adic.regiaoDif = null; adic.erro = "";
  adic.passo = "regiao"; adicionarDesenhar();
}
function adicionarRegiaoContinuar() {
  if (!regiaoValida(adic.regiao)) { adic.erro = t("adicionar.regiao_falta"); adicionarDesenhar(); return; }
  adic.erro = "";
  return adicionarPedir(false);
}

// ---- protobuf em bruto (só etiquetas e tamanhos; os valores não são interpretados)
function pbVarint(n) { const out = []; let v = BigInt(n); while (v >= 0x80n) { out.push(Number(v & 0x7fn) | 0x80); v >>= 7n; } out.push(Number(v)); return Uint8Array.from(out); }
function pbJuntar(...partes) {
  const r = new Uint8Array(partes.reduce((n, p) => n + p.length, 0)); let i = 0;
  for (const p of partes) { r.set(p, i); i += p.length; }
  return r;
}
function pbCampoBytes(num, bytes) { return pbJuntar(pbVarint(num * 8 + 2), pbVarint(bytes.length), bytes); }
function pbCampos(b) {
  const out = []; let p = 0;
  const lerV = () => { let r = 0n, s = 0n; for (;;) { if (p >= b.length) throw new Error("protobuf cortado"); const x = b[p++]; r |= BigInt(x & 0x7f) << s; s += 7n; if (!(x & 0x80)) return r; } };
  while (p < b.length) {
    const tag = lerV(), num = Number(tag >> 3n), fio = Number(tag & 7n);
    if (fio === 0) out.push({ num, fio, valor: lerV() });
    else if (fio === 2) { const n = Number(lerV()); if (p + n > b.length) throw new Error("protobuf cortado"); out.push({ num, fio, valor: b.subarray(p, p + n) }); p += n; }
    else if (fio === 5) { p += 4; out.push({ num, fio }); }
    else if (fio === 1) { p += 8; out.push({ num, fio }); }
    else throw new Error("protobuf: tipo " + fio);
  }
  return out;
}
function deB64(s) { const t = atob(s); const b = new Uint8Array(t.length); for (let i = 0; i < t.length; i++) b[i] = t.charCodeAt(i); return b; }
function bytesIguais(a, b) { if (!a || !b || a.length !== b.length) return false; for (let i = 0; i < a.length; i++) if (a[i] !== b[i]) return false; return true; }

// ---- o que o Geo mostra ao ligar (FromRadio.config / moduleConfig), guardado só durante «Adicionar um Geo»
function adicionarGuardarDefinicao(tipo, bytes) {
  if (!adic.radio || !bytes || !bytes.length) return;
  let c; try { c = pbCampos(bytes)[0]; } catch (e) { return; }
  if (!c || c.fio !== 2) return;
  adic.radio[tipo === "config" ? "config" : "modulo"][c.num] = new Uint8Array(c.valor);
}
function adicionarCaiu() { if (adic.radio) adic.radio.caiu = true; }

function adicionarComChave(sub, k) {
  const chave = deB64(k.chave); let n = 0, tem = false;
  for (const c of pbCampos(sub)) {
    if (c.num === k.gerido && c.fio === 0 && c.valor) throw new Error("gerido");
    if (c.num === k.numero && c.fio === 2) { n++; if (bytesIguais(c.valor, chave)) tem = true; }
  }
  if (tem) return sub;
  if (n >= 3) throw new Error("chaves_cheias");
  return pbJuntar(sub, pbCampoBytes(k.numero, chave));
}
function adicionarCarga(p) {
  if (p.t === "admin") return deB64(p.carga);
  const fonte = p.alvo === "config" ? adic.radio.config : adic.radio.modulo;
  let sub = fonte[p.numero] || new Uint8Array(0);
  if (p.chave_admin) sub = adicionarComChave(sub, p.chave_admin);
  sub = pbJuntar(sub, deB64(p.remendo));
  return pbCampoBytes(p.campo_admin, pbCampoBytes(p.numero, sub));
}
// Administração local: pacote para o próprio Geo (o firmware aceita-o do telemóvel ligado, sem chave de sessão)
async function adicionarEscreverAdmin(carga) {
  const pacote = { to: radio.meu.num >>> 0, channel: 0, id: radioIdPacote(), want_ack: false, hop_limit: 3,
                   decoded: { portnum: ADIC.PORTA_ADMIN, payload: carga, want_response: false } };
  await radioEscrever(GeoProto.codificar("ToRadio", { packet: pacote }));
}

// ---- passos
function adicionarAbrir() {
  Object.assign(adic, { passo: navigator.bluetooth ? "inicio" : "sem_bluetooth", erro: "", token: null, plano: null, pin: null,
                        resultado: null, limite: null, progresso: 0, total: 0, regiaoGeo: null, regiaoConfirmada: false,
                        regiaoDif: null, extra: false });
  $a("adicionar").hidden = false;
  adicionarDesenhar();
  const i = $a("adicionar-nome"); if (i) i.focus();
}
function adicionarOcupado() { return ["a_gravar", "a_reiniciar", "a_confirmar", "a_ponte"].includes(adic.passo); }
async function adicionarFechar() {
  if (adicionarOcupado()) return;
  if (adic.passo === "a_religar") console.warn("adicionar um Geo: fechado à espera de religar", adic.falhou);
  const restaurar = adic.radio !== null;
  adic.passo = "fechado";
  $a("adicionar").hidden = true;
  if (restaurar) await adicionarLimpar();
}
// Fim (bem ou mal): a ponte volta a andar e, se havia outro Geo ligado ao telemóvel, volta-se a ele
// Sem sucesso, o Geo novo é largado sempre: senão a ligação nativa do Android fica agarrada a ele, a tentar religar,
// e o Geo deixa de se anunciar (não aparece na lista para tentar outra vez). Encontrado no T1000-E a 07/11.
async function adicionarLimpar(sucesso = false) {
  window.georedeAdicionar = false;
  adic.radio = null;
  const ant = adic.anterior, novo = adic.novo; adic.anterior = null; adic.novo = null;
  const comNovo = !!novo && radio.dispositivo === novo;
  if (comNovo && (!sucesso || (ant && ant !== novo))) await adicionarSoltar();
  if (ant && ant !== radio.dispositivo) {
    radioAdotarDispositivo(ant); radio.querLigado = true; radio.tentativa = 0;
    radioConectar().catch(radioCaiu);
  } else if (comNovo && !sucesso) {
    radio.dispositivo = null; radio.dispositivoId = null; radioGuardar(); desenharRadio();
  } else if (radioAtivo()) {
    if (ponteNativa()) ponteNativaVer(); else ponteAgendar(500);
  }
}
// Largar o Geo ligado sem marcar «Desligar» (sem pausa)
async function adicionarSoltar() {
  radio.querLigado = false; clearTimeout(radio.temporizadorReligar); clearInterval(radio.heartbeat);
  try { const RN = navigator.bluetooth && navigator.bluetooth.radioNativo && navigator.bluetooth.radioNativo(); if (RN) await RN.desligar().catch(() => null); } catch (e) { /* nada */ }
  const d = radio.dispositivo;
  try { if (radio.cars) await radioEscrever(GeoProto.codificar("ToRadio", { disconnect: true })); } catch (e) { /* já caiu */ }
  radio.cars = null;
  try { if (d && d.gatt && d.gatt.connected) d.gatt.disconnect(); } catch (e) { /* nada */ }
  radio.estado = "desligado"; desenharRadio();
}
function adicionarErro(texto) { adic.passo = "erro"; adic.erro = texto; adicionarDesenhar(); }

async function adicionarLigar() {
  const campo = $a("adicionar-nome");
  adic.nome = ((campo && campo.value) || "").split(/\s+/).filter(Boolean).join(" ");
  const esc = document.querySelector('input[name="adicionar-perfil"]:checked');
  adic.perfil = esc ? esc.value : "cao";
  if (!adic.nome || adic.nome.length > ADIC.NOME_MAX) { adic.erro = t("adicionar.falta_nome"); adicionarDesenhar(); return; }
  adic.erro = ""; adic.passo = "a_ligar"; adicionarDesenhar();
  adic.anterior = (radio.dispositivo && (radio.querLigado || radio.cars)) ? radio.dispositivo : null;
  window.georedeAdicionar = true;
  adic.radio = { config: {}, modulo: {}, caiu: false };
  try { localStorage.removeItem(RADIO_PAUSA); } catch (e) { /* nada */ }
  try {
    if (radio.cars || radio.querLigado) await adicionarSoltar();
    const d = await navigator.bluetooth.requestDevice({ filters: [{ services: [RADIO.UUID.servico] }] });
    radioAdotarDispositivo(d); adic.novo = d; radio.querLigado = true; radio.tentativa = 0;
    await radioConectar();
  } catch (e) {
    if (adic.passo !== "a_ligar") return;
    if (e && e.name === "NotFoundError") { await adicionarLimpar(); adic.passo = "inicio"; adicionarDesenhar(); return; }
    await adicionarLimpar();
    return adicionarErro(t("adicionar.erro_ligar", { motivo: radioMotivo(e) }));
  }
  if (!radio.meu || !radio.meu.num) { await adicionarLimpar(); return adicionarErro(t("adicionar.erro_definicoes")); }
  if (adic.perfil === "casa" && radio.meu.wifi === false) { await adicionarLimpar(); return adicionarErro(t("adicionar.erro_sem_wifi")); }
  return adicionarRegiao();
}

async function adicionarPedir(extra) {
  adic.extra = !!extra;
  adic.passo = "a_pedir"; adicionarDesenhar();
  let r;
  try {
    r = await enviar("/api/geos/adicionar", { node_id: radio.meu.num >>> 0, nome: adic.nome, perfil: adic.perfil,
                                              versao: radio.meu.versao || "", modelo: radio.meu.modelo || 0, extra,
                                              regiao: adic.regiao, regiao_confirmada: !!adic.regiaoConfirmada });
  } catch (e) { await adicionarLimpar(); return adicionarErro(t("erro.pedido")); }
  if (adic.passo !== "a_pedir") return;
  if (!r.ok) {
    if (r.corpo.codigo === "limite") { adic.passo = "limite"; adic.limite = r.corpo; adicionarDesenhar(); return; }
    if (r.corpo.codigo === "regiao_diferente") { adic.passo = "regiao_diferente"; adic.regiaoDif = r.corpo; adicionarDesenhar(); return; }
    await adicionarLimpar();
    return adicionarErro(r.corpo.erro || t("erro.pedido"));
  }
  adic.token = r.corpo.token; adic.reconfigurar = !!r.corpo.reconfigurar;
  adic.passo = "a_preparar"; adicionarDesenhar();
  const fim = Date.now() + ADIC.PREPARAR_MS;
  while (Date.now() < fim) {
    await radioEsperar(1500);
    if (adic.passo !== "a_preparar") return;
    let v;
    try { v = await obter("/api/geos/adicionar?token=" + encodeURIComponent(adic.token)); } catch (e) { continue; }
    if (v.estado === "pronto") {
      // O MQTT (ponte pelo telemóvel) não vai na transação: o T1000-E grava logo tudo e reinicia ao recebê-lo (07/11,
      // 3 vezes, sempre a seguir à mensagem 10). Vai sozinho no fim, com o Geo já gravado e confirmado na conta.
      const depois = p => p.depois || ADIC.DEPOIS.includes(p.o);
      adic.depois = v.plano.filter(depois);
      adic.plano = v.plano.filter(p => !depois(p));
      adic.pin = v.pin || null; adic.nomeLongo = v.nome_longo || "";
      return adicionarGravar();
    }
    if (v.estado === "falhou" || v.estado === "expirado") break;
  }
  await adicionarLimpar();
  adicionarErro(t("adicionar.erro_servidor"));
}

async function adicionarGravar(tentativa = 1) {
  if (!radioAtivo()) { await adicionarLimpar(); return adicionarErro(t("adicionar.erro_caiu")); }
  for (const p of adic.plano) {
    if (p.t === "fundir" && p.alvo === "config" && !adic.radio.config[p.numero]) { await adicionarLimpar(); return adicionarErro(t("adicionar.erro_definicoes")); }
  }
  let cargas;
  try { cargas = adic.plano.map(adicionarCarga); }
  catch (e) {
    await adicionarLimpar();
    return adicionarErro(t(e.message === "gerido" ? "adicionar.erro_gerido" : e.message === "chaves_cheias" ? "adicionar.erro_chaves" : "adicionar.erro_definicoes"));
  }
  adic.passo = "a_gravar"; adic.total = cargas.length; adic.progresso = 0; adic.radio.caiu = false; adicionarDesenhar();
  for (let i = 0; i < cargas.length; i++) {
    const ultimo = i === cargas.length - 1;
    if (ultimo) { adic.radio.caiu = false; adic.radio.config = {}; adic.radio.modulo = {}; }   // depois de gravar, lê-se tudo outra vez
    try {
      if (!ultimo && adic.radio.caiu) throw new Error("a ligação caiu");
      await adicionarEscreverAdmin(cargas[i]);
    } catch (e) {
      if (ultimo && adic.radio.caiu) break;                         // reiniciou logo a seguir a gravar: é o esperado
      const o = adic.plano[i].o, motivo = String((e && e.message) || e).slice(0, 80);
      console.warn("adicionar um Geo: a escrita falhou em", o, `(${i + 1} de ${cargas.length}):`, e);
      // Sem «gravar», o Geo não guardou nada: volta a ligar e repete a transação inteira, uma vez
      adic.falhou = { o, n: i + 1, total: cargas.length, motivo };
      if (tentativa < ADIC.TENTATIVAS) return adicionarRepetir(tentativa);
      await adicionarLimpar();
      return adicionarErro(t("adicionar.erro_caiu_passo", { o, n: i + 1, total: cargas.length, motivo }));
    }
    adic.progresso = i + 1; adicionarDesenhar();
    if (!ultimo) await radioEsperar(ADIC.ENTRE_ESCRITAS_MS);
  }
  return adicionarEsperarReinicio();
}
async function adicionarRepetir(tentativa) {
  adic.passo = "a_religar"; adicionarDesenhar();
  const seg = adic.plano.find(p => p.chave_admin);
  adic.radio.config = {}; adic.radio.modulo = {};
  // se a ligação ainda está (a escrita falhou sem cair), pede-se a configuração outra vez; se caiu, a app religa sozinha
  if (radioAtivo()) {
    try { await Promise.race([radioConfigurar(), radioEsperar(RADIO.ESPERA_CONFIG_MS + 2000)]); } catch (e) { /* espera pela religação */ }
  }
  const fim = Date.now() + ADIC.RELIGAR_MS;
  while (Date.now() < fim) {
    if (adic.passo !== "a_religar") return;
    if (radioAtivo() && radio.configCompleta && (!seg || adic.radio.config[seg.numero])) return adicionarGravar(tentativa + 1);
    await radioEsperar(500);
  }
  await adicionarLimpar();
  adicionarErro(t("adicionar.erro_caiu"));
}

async function adicionarEsperarReinicio() {
  adic.passo = "a_reiniciar"; adicionarDesenhar();
  const inicio = Date.now();
  while (Date.now() - inicio < ADIC.REINICIAR_MS) {
    await radioEsperar(500);
    if (adic.passo !== "a_reiniciar") return;
    if (adic.radio.caiu && radioAtivo() && radio.configCompleta) return adicionarVerificar();
    if (!adic.radio.caiu && radioAtivo() && Date.now() - inicio > ADIC.SEM_QUEDA_MS) {
      // não se viu o Geo reiniciar: pedir-lhe a configuração outra vez e conferir na mesma
      try { await radioConfigurar(); } catch (e) { /* confere-se com o que houver */ }
      return adicionarVerificar();
    }
  }
  await adicionarLimpar();
  adicionarErro(t("adicionar.erro_reinicio"));
}

function adicionarVerificado() {
  const n = radio.nos.get(radio.meu.num >>> 0) || {};
  const ps = adic.plano.find(p => p.chave_admin);
  const sub = ps && adic.radio.config[ps.numero];
  let chave = false;
  try { chave = !!sub && pbCampos(sub).some(c => c.num === ps.chave_admin.numero && c.fio === 2 && bytesIguais(c.valor, deB64(ps.chave_admin.chave))); } catch (e) { chave = false; }
  return { canais: [0, 1].map(i => (radio.canais[i] && radio.canais[i].nome) || ""), dono: n.nome || "",
           chave_admin: chave, chave_propria: !!n.chave };
}
async function adicionarVerificar() {
  adic.passo = "a_confirmar"; adicionarDesenhar();
  const v = adicionarVerificado();
  const falta = [];
  if (v.canais[0] !== "GeoRede" || v.canais[1] !== "GeoCmd") falta.push(t("adicionar.falta_canais"));
  if (v.dono !== adic.nomeLongo) falta.push(t("adicionar.falta_nome_geo"));
  if (!v.chave_admin) falta.push(t("adicionar.falta_chave"));
  if (falta.length) { await adicionarLimpar(); return adicionarErro(t("adicionar.erro_verificar", { falta: falta.join(", ") })); }
  let r;
  try { r = await enviar("/api/geos/adicionar/confirmar", { token: adic.token, verificado: v }); }
  catch (e) { r = { ok: false, corpo: {} }; }
  if (!r.ok) { await adicionarLimpar(); return adicionarErro(r.corpo.erro || t("erro.pedido")); }
  adic.resultado = r.corpo;
  if (adic.depois && adic.depois.length && radioAtivo()) {
    adic.passo = "a_ponte"; adicionarDesenhar();
    for (const p of adic.depois) {
      try { await adicionarEscreverAdmin(adicionarCarga(p)); } catch (e) { console.warn("adicionar um Geo: depois", p.o, e); }
      await radioEsperar(ADIC.ENTRE_ESCRITAS_MS);
    }
    await radioEsperar(3000);
  }
  if (adicionarFarol()) return adicionarFarolWifi();
  adic.passo = "feito"; adicionarDesenhar();
  try { await atualizar(); } catch (e) { /* o mapa atualiza-se sozinho */ }
}

// ---- Farol (08/11/2026): o Wi-Fi escreve-se no ecrã do Farol; a app só espera que ele apareça no servidor
function adicionarFarol() { return adic.perfil === "casa" || !!(adic.resultado && adic.resultado.farol); }
async function adicionarFarolWifi() {
