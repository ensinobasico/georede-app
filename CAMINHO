}
// Revisão da UI (09/11): o plano está no topo de «Mais», numa linha: «Fundador · 39 € para sempre» + «Aderir»
// Mostra-se a compra do Fundador? Só com a loja aberta e fora da app Android (regras de pagamento da Google Play).
function planoComprar() { return LOJA_ABERTA && !/GEOREDE-Android/.test(navigator.userAgent || ""); }
async function planoDesenhar(o) {
  const caixa = $r("rede-plano"), b = $r("rede-fundador"), dica = $r("rede-plano-dica"), txt = $r("rede-plano-texto");
  const legal = $r("rede-plano-legal");
  caixa.classList.remove("pago");
  if (o.plano === "fundador") {
    txt.textContent = t("plano.fundador_curto"); b.hidden = true; dica.hidden = true; legal.hidden = true;
    $r("rede-licenca").hidden = true; caixa.classList.add("pago"); caixa.hidden = false; return;
  }
  if (!planoComprar()) { caixa.hidden = true; return; }       // loja fechada, ou app Android: sem ofertas de compra
  txt.textContent = t("plano.testes"); caixa.hidden = false; $r("rede-licenca").hidden = false;
  let f;
  try { f = await obter("/api/fundadores"); } catch (e) { b.hidden = true; dica.hidden = true; legal.hidden = true; return; }
  if (!f.ligado || !f.aberto) { b.hidden = true; dica.hidden = true; legal.hidden = true; return; }
  txt.textContent = t("plano.linha", { preco: f.preco });
