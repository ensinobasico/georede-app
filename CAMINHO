  .caminho .nomes span { overflow: hidden; text-overflow: ellipsis; max-width: 36%; }
  .caminho .nomes span:nth-child(2) { text-align: center; }
  @keyframes caminho-luz { 0% { left: 0%; } 40% { left: 50%; } 60% { left: 50%; } 100% { left: 100%; } }
  @keyframes caminho-no { 0%, 100% { background: rgba(255,255,255,.45); transform: scale(1); } 20% { background: #fff; transform: scale(1.5); } }
  @media (prefers-reduced-motion: reduce) { .caminho .no, .caminho .luz { animation: none; } .caminho .luz { display: none; } }

