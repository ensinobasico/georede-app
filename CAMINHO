// ---- notificações no telemóvel (Web Push). O servidor cifra cada aviso só para este aparelho.
const estadoPush = { chave: null, preparado: false };
// Na app Android não há Web Push: o plugin nativo GeoredePush (Firebase) faz o mesmo papel, com as mesmas chaves
// e a mesma cifra; o servidor só vê um endereço "fcm-android:…" em vez de um https://… do browser.
function pushPlugin() {
  if (!/GEOREDE-Android/.test(navigator.userAgent || "")) return null;
  const C = window.Capacitor;
  return (C && C.Plugins && C.Plugins.GeoredePush) || null;
}
const temPush = !!pushPlugin() || ("serviceWorker" in navigator && "PushManager" in window && "Notification" in window);
const eIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
const instalada = window.matchMedia("(display-mode: standalone)").matches || navigator.standalone === true;
const registoSW = "serviceWorker" in navigator
  ? navigator.serviceWorker.register("/sw.js").catch(e => { console.warn("service worker:", e); return null; })
  : Promise.resolve(null);
function chaveBytes(b64) {
  const b = atob((b64 + "=".repeat((4 - b64.length % 4) % 4)).replace(/-/g, "+").replace(/_/g, "/"));
  return Uint8Array.from(b, c => c.charCodeAt(0));
}
function mesmaChave(sub, chave) {
  const atual = sub.options && sub.options.applicationServerKey;
  if (!atual) return true;
  const a = new Uint8Array(atual);
  return a.length === chave.length && a.every((x, i) => x === chave[i]);
}
function dicaPush(texto, erro) {
  const p = document.getElementById("push-dica");
  p.textContent = texto || ""; p.hidden = !texto; p.className = erro ? "dica erro" : "dica";
}
function mostrarTestePush(sim) { document.getElementById("push-testar").hidden = !sim; }
async function prepararPush() {
  try { estadoPush.chave = (await obter("/api/push/chave")).chave; } catch (e) { return; }
  if (!estadoPush.chave) return;                  // o servidor ainda não tem as notificações ligadas
  document.getElementById("push-caixa").hidden = false;
  const campo = document.getElementById("pref-push");
  const P = pushPlugin();
  if (P) {
    // App Android: o estado vem do plugin; se o Firebase trocou o token, volta a dizê-lo ao servidor
    let e = null;
    try { e = await P.estado(); } catch (err) { console.warn("notificações:", err); }
    const ligado = !!(e && e.subscrito && e.autorizadas);
    campo.checked = ligado;
    mostrarTestePush(ligado);
    if (e && e.subscrito && !e.autorizadas) dicaPush(t("push.bloqueadas_app"));
    if (ligado) {
      try {
        const r = await P.subscrever();
        if (r && r.endpoint && r.keys) enviar("/api/push/subscrever", { endpoint: r.endpoint, keys: r.keys }).catch(() => {});
      } catch (err) { console.warn("notificações:", err); }
    }
    return;
  }
  if (!temPush) { campo.disabled = true; dicaPush(eIOS && !instalada ? t("push.ios") : t("push.sem_suporte")); return; }
  if (Notification.permission === "denied") { campo.disabled = true; dicaPush(t("push.bloqueadas")); return; }
  const reg = await registoSW;
  if (!reg) { campo.disabled = true; dicaPush(t("push.sem_suporte")); return; }
  const sub = await reg.pushManager.getSubscription();
  const ligado = !!sub && Notification.permission === "granted";
  campo.checked = ligado;
  mostrarTestePush(ligado);
  // Volta a dizer ao servidor que este aparelho quer avisos (a subscrição pode ter mudado entretanto)
  if (ligado) enviar("/api/push/subscrever", sub.toJSON()).catch(() => {});
}
document.getElementById("pref-push").addEventListener("change", async e => {
  const campo = e.target, ligar = campo.checked;
  campo.disabled = true; dicaPush("");
  try {
    const P = pushPlugin();
    if (P) {
      if (ligar) {
        const r = await P.subscrever();
        if (!r || r.recusada || r.autorizadas === false) { campo.checked = false; dicaPush(t("push.bloqueadas_app")); return; }
        if (!r.endpoint || !r.keys) throw new Error("sem token");
        const resp = await enviar("/api/push/subscrever", { endpoint: r.endpoint, keys: r.keys });
        if (!resp.ok) throw new Error(resp.corpo.erro || "falhou");
        dicaPush(t("push.ligadas"));
      } else {
        const r = await P.cancelar();
        if (r && r.endpoint) await enviar("/api/push/cancelar", { endpoint: r.endpoint }).catch(() => {});
      }
      return;
    }
    const reg = await registoSW;
    if (ligar) {
      const autorizacao = await Notification.requestPermission();
      if (autorizacao !== "granted") {
        campo.checked = false;
        if (autorizacao === "denied") dicaPush(t("push.bloqueadas"));
        return;
      }
      const chave = chaveBytes(estadoPush.chave);
      let sub = await reg.pushManager.getSubscription();
      if (sub && !mesmaChave(sub, chave)) { await sub.unsubscribe(); sub = null; }
      if (!sub) sub = await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: chave });
      const r = await enviar("/api/push/subscrever", sub.toJSON());
      if (!r.ok) throw new Error(r.corpo.erro || "falhou");
      dicaPush(t("push.ligadas"));
    } else {
      const sub = await reg.pushManager.getSubscription();
      if (sub) {
        await enviar("/api/push/cancelar", { endpoint: sub.endpoint }).catch(() => {});
        await sub.unsubscribe();
      }
    }
  } catch (err) {
    console.error(err);
    if (err.message !== "sessão expirada") { campo.checked = !ligar; dicaPush(t("push.erro"), true); }
  } finally {
    campo.disabled = !pushPlugin() && "Notification" in window && Notification.permission === "denied";
    mostrarTestePush(campo.checked);
  }
});
