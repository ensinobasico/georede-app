    color: var(--tinta); background: none; border: 0; border-radius: 9px; cursor: pointer; }
  .voz-linguas button:hover, .voz-linguas button:focus-visible { background: var(--nevoa); }
  .voz-linguas button[aria-checked="true"]::after { content: "✓"; color: var(--azul); font-weight: 700; }

  .voz-auto-caixa .dica { margin: -4px 0 0; }
