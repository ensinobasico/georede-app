// ---- botão «para trás» do Android (11/11/2026)
// Cada entrada do histórico da app leva um contador (_n): 0 = o primeiro ecrã aberto. Assim sabe-se se ainda há
// para onde voltar dentro da app, sem cair nas páginas do login que ficaram para trás no WebView.
(function () {
  const push = history.pushState.bind(history), troca = history.replaceState.bind(history);
  const n = () => (history.state && history.state._n) || 0;
  history.pushState = (s, t, u) => push({ ...(s || {}), _n: n() + 1 }, t, u);
  history.replaceState = (s, t, u) => troca({ ...(s || {}), _n: n() }, t, u);
})();
// Chamado pela MainActivity.java. true = a página tratou do toque; false = já está no início (a app vai para trás).
window.georedeVoltar = function () {
  const visivel = id => { const e = document.getElementById(id); return e && !e.hidden; };
  if (document.getElementById("saiu")) return false;
  if (tut.ativo) { tutFechar(); return true; }
  // 1. janelas por cima de tudo
  if (visivel("legal")) { legalFechar(); return true; }
  if (visivel("ativar") && entradaPasso() !== "escolha") { entradaIr("escolha"); return true; }
  if (visivel("seta") && typeof setaFechar === "function") { setaFechar(); return true; }
  if (visivel("adicionar") && typeof adicionarFechar === "function") { adicionarFechar(); return true; }
  if (visivel("achado") && typeof achadoFechar === "function") { achadoFechar(); return true; }
  // 2. coisas abertas dentro do ecrã atual
  if (visivel("voz-linguas")) { vozFecharLinguas(); return true; }
  if (estado.editor) { fecharEditor(); return true; }
  if (typeof aRenomear !== "undefined" && aRenomear !== null) { fecharRenomear(); return true; }
  if (typeof aConfirmar !== "undefined" && aConfirmar !== null) { fecharConfirmar(); return true; }
  // 3. sobe um nível na árvore dos menus (12/11/2026). Não usa o histórico: antes, depois de saltar entre
  //    separadores, o «para trás» refazia todos os saltos ao contrário. Agora:
  //    conversa/rápidas → Mensagens; Geo → A tua rede; definições → Alertas; A tua rede/Histórico/Rotas/Sinal → Mais;
  //    qualquer separador (Mensagens, Zonas, Alertas, Mais) → Mapa; no Mapa → a app vai para segundo plano.
  const v = estado.vista;
  if (v === "mensagens" && (estado.msg.aberta !== null || estado.msg.editarRapidas)) {
    history.replaceState({ v: "mensagens" }, "", "/mensagens");
    fecharConversa("nada"); return true;
  }
  if (v === "aparelhos" && estado.geoAberto !== null) {
    estado.geoAberto = null; aConfirmar = null; aRenomear = null;
    history.replaceState({ v: "aparelhos" }, "", "/aparelhos");
    desenharAparelhos(); atualizarTopo();
    document.getElementById("vista-aparelhos").scrollTop = 0;
    return true;
  }
  if (v === "alertas" && estado.alertasDef) {
    estado.alertasDef = false;
    history.replaceState({ v: "alertas" }, "", "/alertas");
    desenharDefAlertas(); return true;
  }
  if (DO_MAIS.includes(v) && eTelemovel()) { mudarVista("mais", "substituir"); return true; }
  if (v !== "mapa") { mudarVista("mapa", "substituir"); return true; }
  return false;
};

// ---- zonas
function circulo(lat, lon, raio, pontos = 64) {
  const R = 6371008.8, d = raio / R, f1 = lat * Math.PI / 180, l1 = lon * Math.PI / 180, anel = [];
  for (let i = 0; i <= pontos; i++) {
    const b = 2 * Math.PI * i / pontos;
    const f2 = Math.asin(Math.sin(f1) * Math.cos(d) + Math.cos(f1) * Math.sin(d) * Math.cos(b));
    const l2 = l1 + Math.atan2(Math.sin(b) * Math.sin(d) * Math.cos(f1), Math.cos(d) - Math.sin(f1) * Math.sin(f2));
    anel.push([l2 * 180 / Math.PI, f2 * 180 / Math.PI]);
  }
  return { type: "Feature", properties: {}, geometry: { type: "Polygon", coordinates: [anel] } };
}
function limitesZona(z) {
  const c = circulo(z.lat, z.lon, z.raio, 16).geometry.coordinates[0];
  return c.reduce((b, p) => b.extend(p), new maplibregl.LngLatBounds(c[0], c[0]));
}
function desenharZonasMapa() {
  const f = mapa.getSource("zonas");
  if (f) f.setData({ type: "FeatureCollection", features: estado.zonas
    .filter(z => !estado.editor || z.id !== estado.editor.id)
    .map(z => ({ ...circulo(z.lat, z.lon, z.raio), properties: { id: z.id } })) });
  const e = mapa.getSource("zona-editor");
  if (e) e.setData({ type: "FeatureCollection", features: estado.editor
    ? [circulo(estado.editor.lat, estado.editor.lon, estado.editor.raio)] : [] });
}
