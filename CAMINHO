  const guardar = document.createElement("button"); guardar.type = "button"; guardar.className = "principal"; guardar.textContent = t("achado.guardar");
  guardar.addEventListener("click", achadoGuardar);
  const trocar = document.createElement("button"); trocar.type = "button"; trocar.textContent = t("achado.trocar");
  trocar.addEventListener("click", achadoTrocar);
  c.append(img, u, ligacoes, caixa("achado-ativo", t("achado.ativo"), D.ativo), caixa("achado-mostrar", t("achado.mostrar"), D.mostrar_telefone), tel);
  if (aviso) c.append(p(aviso, erro ? "erro" : "aviso"));
  c.append(guardar, p(t("achado.trocar_dica"), "dica"), trocar, p(t("achado.pin"), "dica"));
}
async function achadoGuardar() {
  const r = await enviar("/api/achados", { node_id: achado.dados.node_id, ativo: $q("achado-ativo").checked,
    mostrar_telefone: $q("achado-mostrar").checked, telefone: $q("achado-telefone").value });
  if (!r.ok) return achadoDesenhar(r.corpo.erro || t("erro.pedido"), true);
  achado.dados = r.corpo; achadoDesenhar(t("achado.guardado"));
