  .topo-btn svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  .topo-voltar { margin-right: 0; }
  .topo h1 { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .topo .estado { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; white-space: nowrap; }
  .estado-ponto { width: 8px; height: 8px; border-radius: 50%; background: var(--tinta-2); flex: none; }
  .estado-ponto.direto { background: var(--verde); box-shadow: 0 0 0 3px color-mix(in srgb, var(--verde) 22%, transparent); }
  .topo .seta { display: none !important; }
  .topo-acao { margin-left: 2px; }

  /* Cada secção rola inteira: as caixas lá dentro não encolhem (antes o menu de «Mais» ficava espremido) */
  .vista:not(.vista-msg) > * { flex-shrink: 0; }
  /* Esbatido em baixo enquanto há mais para ver */
  .vista.tem-mais, .msg-conversas.tem-mais {
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 56px), transparent);
            mask-image: linear-gradient(to bottom, #000 calc(100% - 56px), transparent);
  }
  .painel-fundo { position: fixed; inset: 0 0 var(--nav-altura) 0; z-index: 2; background: rgba(6, 10, 16, .5); }
  .painel-sonda { position: fixed; left: 0; width: 0; height: 0; top: calc(env(safe-area-inset-top) + 56px); pointer-events: none; visibility: hidden; }

  /* Navegação no telemóvel: pílula atrás do ícone da secção onde estás */
  @media (max-width: 700px) {
    .navegacao a { font-size: 12px; gap: 4px; }
    .navegacao a .ico { box-sizing: content-box; width: 22px; height: 22px; padding: 4px 18px; border-radius: 16px; transition: background .15s; }
    .navegacao a[aria-current="page"] .ico { background: color-mix(in srgb, var(--azul) 16%, transparent); }
    .navegacao a[aria-current="page"] { font-weight: 700; }
    .navegacao .contador { top: 4px; left: calc(50% + 10px); }

    /* Painel com 3 alturas: meio (até metade), alto (quase tudo), baixo (encolhido) */
    .painel { max-height: 52vh; max-height: 52dvh; }
    .painel.alto:not(.cheio):not(.encolhido) { top: calc(env(safe-area-inset-top) + 56px); max-height: none;
      box-shadow: 0 -8px 30px rgba(0, 0, 0, .35); }
    .painel.a-arrastar { user-select: none; -webkit-user-select: none; }
    .painel.cheio .puxador { display: none; }
    .painel.cheio:not(.encolhido) .topo { padding-top: 14px; }
    .painel.cheio .topo { cursor: default; touch-action: auto; }
    .puxador { height: 24px; }
    .puxador::before { width: 44px; height: 5px; background: color-mix(in srgb, var(--tinta-2) 45%, transparent); }
  }

  /* 1.5: no cartão «A procurar», só «Ir até lá» é principal; tocar no cartão centra o mapa */
  .procura-cartao { cursor: pointer; }
  .procura-cartao .acoes { grid-template-columns: 1fr auto auto; }
  .procura-cartao button.seta-ir { width: auto; margin: 0; }
  .procura-cartao button { min-height: 40px; }

  /* 1.6: bateria ≤ 25 % âmbar, ≤ 10 % vermelho */
  .bateria.baixa { color: var(--ambar); font-weight: 600; }
  .bateria.baixa .carga { fill: var(--ambar); }
  @media (prefers-color-scheme: dark) { :root { --ambar: #E0A23A; } }

  /* 2.x Alertas: histórico por dia, ícone por tipo, definições com interruptores */
  .alertas-lista { border-top: 0; padding-top: 0; }
  .alertas-lista .dia-cab { margin: 14px 10px 4px; font-size: 12.5px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--tinta-2); }
  .alertas-lista .dia-cab:first-child { margin-top: 4px; }
  .alertas-lista button { grid-template-columns: 38px 1fr auto; gap: 2px 12px; padding: 10px 8px; }
  .alertas-lista .alerta-ico { grid-row: 1 / 3; width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center;
    --c: var(--tinta-2); color: var(--c); background: color-mix(in srgb, var(--c) 16%, transparent); }
  .alertas-lista .alerta-ico svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .alertas-lista .alerta-ico.tipo-sair { --c: #D97706; background: color-mix(in srgb, var(--c) 16%, transparent); }
  .alertas-lista .alerta-ico.tipo-entrar, .alertas-lista .alerta-ico.tipo-encontrei { --c: var(--verde); background: color-mix(in srgb, var(--c) 16%, transparent); }
  .alertas-lista .alerta-ico.tipo-bateria { --c: var(--ambar); background: color-mix(in srgb, var(--c) 16%, transparent); }
  .alertas-lista .alerta-ico.tipo-sem_sinal { --c: var(--tinta-2); background: color-mix(in srgb, var(--c) 16%, transparent); }
  .alertas-lista .nome { white-space: normal; font-size: 15px; }
  .alertas-lista .visto { display: inline-flex; align-items: center; gap: 6px; }
  .alertas-lista .novo { width: 8px; height: 8px; border-radius: 50%; background: var(--azul); }
  @media (prefers-color-scheme: dark) { .alertas-lista .novo { background: var(--foco); } }
  .alertas-lista .vazio { margin: 16px 10px; }
  .voltar-linha { display: none; }
  .alertas-def .grupo-def { margin: 4px 16px 0; padding: 4px 14px; border-radius: 14px; background: var(--nevoa); border: 1px solid var(--linha); }
  .alertas-def .preferencia { margin: 0; }
  .alertas-def .push-caixa { margin: 0; padding: 10px 0; border-bottom: 1px solid var(--linha); }
  .alertas-def .push-caixa .dica { margin: 4px 0 0; }
  .alertas-def .push-caixa .testar {
    margin: 10px 0 0; padding: 10px 14px; width: 100%; font-weight: 600; font-size: 14px; text-decoration: none;
    color: var(--tinta); background: var(--painel); border: 1px solid var(--linha); border-radius: 10px;
  }
  .alertas-def .avisos-geo { margin: 0 16px 16px; border: 0; }
  .alertas-def #avisos-lista { padding: 0; }
  .alertas-def .lista-avisos > li { padding: 12px 14px; margin-bottom: 8px; border: 1px solid var(--linha); border-radius: 14px; background: var(--nevoa); }
  .alertas-def .lista-avisos > li:first-child { border-top: 1px solid var(--linha); }
  .aviso-form { background: var(--painel); }

  /* Interruptor (o texto à esquerda, o botão à direita); por dentro continua a ser uma caixa de seleção */
  .opcao.interruptor { justify-content: space-between; gap: 14px; padding: 10px 0; font-size: 15px; min-height: 48px; }
  .opcao.interruptor input {
    appearance: none; -webkit-appearance: none; flex: none; position: relative; width: 48px; height: 28px; margin: 0; cursor: pointer;
    border-radius: 14px; background: color-mix(in srgb, var(--tinta-2) 45%, transparent); transition: background .15s;
  }
  .opcao.interruptor input::after {
    content: ""; position: absolute; top: 3px; left: 3px; width: 22px; height: 22px; border-radius: 50%; background: #fff;
    box-shadow: 0 1px 3px rgba(0, 0, 0, .3); transition: transform .15s;
  }
  .opcao.interruptor input:checked { background: var(--azul); }
