  else if (x.estado === "falhou") { txt = t("msg.falhou"); if (x.motivo) r.title = x.motivo; }
  else if (x.tentativas > 0) { txt = t("msg.a_espera"); ico = ICONE_RELOGIO; }
  else { txt = t("msg.a_passar"); ico = ""; }
  const s = document.createElement("span"); s.textContent = `${h} · ${txt}`;
