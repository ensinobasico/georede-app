async function obter(url) {
  if (window.georedeEmergencia) throw new Error("sessão expirada");      // sem conta: não pede nada ao servidor
  if (demoUrl(url)) {                                                   // Geo de exemplo: responde aqui
    const m = /[?&]horas=(\d+)/.exec(url);
    return String(url).startsWith("/api/trajeto") ? demoTrajeto(m ? +m[1] : 1) : {};
  }
  const r = await fetch(url, { cache: "no-store", credentials: "same-origin" });
  if (r.status === 401) {
    // Sessão terminada ou expirada: volta a entrar e regressa a esta página
    location.href = "/auth/login?destino=" + encodeURIComponent(location.pathname + location.search);
    throw new Error("sessão expirada");
  }
  if (!r.ok) throw new Error(`${url}: ${r.status}`);
  return r.json();
}

async function enviar(url, dados) {
  if (demoUrl(url) || (dados && String(dados.node_id) === String(DEMO_ID))) {
    setTimeout(() => { const av = document.getElementById("aviso"); if (av && av.textContent === t("demo.so_exemplo")) av.hidden = true; }, 6000);
    return { ok: false, status: 400, corpo: { erro: t("demo.so_exemplo") } };
  }
  const r = await fetch(url, {
    method: "POST", cache: "no-store", credentials: "same-origin",
    headers: { "Content-Type": "application/json" }, body: JSON.stringify(dados)
  });
  if (r.status === 401) {
    location.href = "/auth/login?destino=" + encodeURIComponent(location.pathname + location.search);
    throw new Error("sessão expirada");
  }
  let corpo = {};
  try { corpo = await r.json(); } catch (e) { /* resposta sem JSON */ }
  return { ok: r.ok, status: r.status, corpo };
}

