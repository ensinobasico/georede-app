// ---- trajeto no mapa: últimas 24 h, ou desde o último "Limpar" desse Geo (guardado neste telemóvel).
// Cada Geo tem o seu "Limpar"; o Histórico guarda tudo.
const CHAVE_LIMPO = "georede-trajeto-limpo-geo";
function lerLimpos() {
  try { return JSON.parse(localStorage.getItem(CHAVE_LIMPO)) || {}; } catch (e) { return {}; }
}
function gravarLimpos(m) {
  const minimo = Date.now() - 24 * 3600 * 1000;           // os que já passaram das 24 h não interessam
  for (const k of Object.keys(m)) if (!(m[k] > minimo)) delete m[k];
  try { localStorage.setItem(CHAVE_LIMPO, JSON.stringify(m)); } catch (e) { /* sem armazenamento */ }
}
const limposSessao = lerLimpos();                          // também serve se o telemóvel não guardar nada
function limpoEm(node) {
  if (node === null || node === undefined) return 0;
  const v = limposSessao[node] || 0;
  return v > Date.now() - 24 * 3600 * 1000 ? v : 0;        // passadas 24 h, o "Limpar" já não conta
}
function cortarTrajeto(g, desde) {
  if (!desde) return g;
  const pontos = g.features.filter(f => f.properties.tipo === "ponto" && new Date(f.properties.hora).getTime() >= desde);
  const linha = pontos.length > 1 ? [{ type: "Feature", properties: { tipo: "linha" },
    geometry: { type: "LineString", coordinates: pontos.map(f => f.geometry.coordinates) } }] : [];
  return { type: "FeatureCollection", features: linha.concat(pontos) };
}
// ---- Modo Procurar (procurar.py): liga sozinho quando um Geo sai de uma zona, ou aqui no botão "Procurar".
// Enquanto dura (4 h), a app atualiza de 10 em 10 s, mostra a faixa e segue o Geo no mapa.
async function carregarProcuras() {
  const r = await obter("/api/procurar");
  estado.procuras = r.procuras || {};
  estado.procuraH = r.duracao_h || 4;
  for (const id of [...estado.procuraVistas]) {
    if (!(id in estado.procuras)) { estado.procuraVistas.delete(id); delete estado.procuraUltima[id]; }
  }
}
function emProcura(node) { return Object.prototype.hasOwnProperty.call(estado.procuras, String(node)); }
function nomeGeo(node) {
  const a = estado.aparelhos.find(x => x.node_id === node);
  return a ? a.nome : "!" + node.toString(16).padStart(8, "0");
}
// Uma procura que começou agora (ex.: o Geo saiu da zona) passa a ser o Geo escolhido no mapa
function escolherProcura() {
  let nova = null;
  for (const id of Object.keys(estado.procuras)) {
    if (estado.procuraVistas.has(id)) continue;
    estado.procuraVistas.add(id);
    if (estado.vista === "mapa" && !estado.editor) { estado.selecionado = Number(id); nova = Number(id); }
  }
  return nova;
}
// Centra o mapa no Geo procurado quando chega uma posição nova (só o que está escolhido)
function seguirProcura(nova) {
  const node = estado.selecionado;
  if (node === null || !emProcura(node) || estado.editor) return;
  const a = estado.aparelhos.find(x => x.node_id === node);
  if (!a || !a.ultima) return;
  const id = String(node);
  if (nova === node || estado.procuraUltima[id] !== a.ultima.hora) {
