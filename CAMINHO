}
function setaFechar() {
  $s("seta").hidden = true;
  seta.node = null;
  $s("seta-encontro").hidden = true; $s("seta-parar").hidden = true;
  // num encontro em curso o GPS continua (a nossa posição tem de continuar a ir para a outra pessoa)
  if (!encontroEmCurso() && seta.vigia != null && navigator.geolocation) navigator.geolocation.clearWatch(seta.vigia);
  if (!encontroEmCurso()) seta.vigia = null;
  clearInterval(seta.relogio); seta.relogio = null;
  if (seta.ouvinte) { window.removeEventListener(seta.ouvinte.tipo, seta.ouvinte.f, true); seta.ouvinte = null; }
  try { if (seta.trinco) seta.trinco.release(); } catch (e) { /* nada */ }
