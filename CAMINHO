<script>
// ===== GEOREDE — criar a rede pela app e convidar pessoas (07/11/2026; servidor: georede_api/rede.py) =====
"use strict";
const $r = id => document.getElementById(id);
$r("rede-criar").addEventListener("click", async () => {
  const nome = $r("rede-nome").value.trim();
  if (!nome) { mensagem("rede-msg", t("rede.falta_nome"), true); $r("rede-nome").focus(); return; }
  if (!termosAceites("rede-msg")) return;
