    estado.aparelhos = demoJuntar(r.dispositivos);
    mostrarRepetidoresMenu();
    if (typeof baseAgendar === "function") baseAgendar(1500);
    if (typeof radio !== "undefined" && radio.semFamilia) radioLimparEstranhos();
    radioNomesDaFamilia(); radioFundirAparelhos(false);       // posições mais recentes ouvidas pela rádio
    if (estado.conta.cliente_id) {
      try { await carregarProcuras(); } catch (e) { console.error(e); }   // se falhar, o mapa continua
    }
    const novaProcura = escolherProcura();
    document.getElementById("aviso").hidden = true;
    estado.ultimoOk = Date.now();
    desenharEstado();
    if (estado.selecionado === null) {
      const comPosicao = estado.aparelhos.find(a => a.ultima);
      if (comPosicao) estado.selecionado = comPosicao.node_id;
    }
    desenharLista();
    desenharMarcadores();
    if (estado.zonasCarregadas) desenharZonas();
    if (estado.vista === "aparelhos" && aRenomear === null && aConfirmar === null) desenharAparelhos();
    if (estado.vista === "historico" && !estado.hist.dados && !estado.hist.carregando && estado.aparelhos.length) abrirHistorico();
