  /* Animações curtas: a bolha sobe ao enviar, a resposta entra pela esquerda, o ✓✓ faz "pop", a reação balança */
  @keyframes subir { from { transform: translateY(12px); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes entrar-esq { from { transform: translateX(-14px); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes pop { 0% { transform: scale(.3); } 65% { transform: scale(1.3); } 100% { transform: scale(1); } }
  @keyframes balanco { 0%, 100% { transform: rotate(0); } 30% { transform: rotate(-14deg) scale(1.15); } 65% { transform: rotate(10deg); } }
  .linha.nova.minha .bolha { animation: subir .28s ease-out; }
  .linha.nova:not(.minha) .bolha { animation: entrar-esq .3s ease-out; }
  .rodape-bolha.mudou svg { animation: pop .35s ease-out; }
  .reacao.nova { display: inline-block; animation: balanco .5s ease-in-out; }
  @media (prefers-reduced-motion: reduce) {
    .linha.nova .bolha, .rodape-bolha.mudou svg, .reacao.nova { animation: none; }
  }

  /* "A passar pela rede" (ecrã 5 do desenho, aprovado a 31/10): a bolha fica azul e, por baixo do texto, uma linha
     com três Geos (o teu, o do meio, o destino); um ponto de luz desliza de um para o outro e cada Geo acende à passagem */
  .bolha.minha.pendente.a-caminho { color: #fff; background: var(--azul); border-color: var(--azul); }
  .bolha.minha.pendente.a-caminho .rodape-bolha { color: inherit; opacity: .92; }
  .caminho { display: flex; flex-direction: column; gap: 4px; margin-top: 6px; width: 150px; max-width: 100%; }
  .caminho .via { position: relative; height: 14px; margin: 0 6px; display: flex; justify-content: space-between; align-items: center; }
  .caminho .fio { position: absolute; left: 0; right: 0; top: 50%; height: 2px; margin-top: -1px; background: rgba(255,255,255,.3); }
  .caminho .no { position: relative; width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,.55); animation: caminho-no 1.7s ease-in-out infinite; }
  .caminho .luz {
    position: absolute; top: 50%; left: 0; width: 10px; height: 10px; margin: -5px 0 0 -5px; border-radius: 50%;
    background: #fff; box-shadow: 0 0 0 3px rgba(255,255,255,.35); animation: caminho-luz 1.7s ease-in-out infinite;
  }
