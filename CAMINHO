<script>
// ===== GEOREDE — Seta até ao Geo (06/11/2026; decisões em claude/decisoes-06-11.md) =====
// Ecrã por cima do mapa: distância e direção do telemóvel até à última posição do Geo, com uma seta que roda com a
// bússola. Funciona SEM INTERNET: o GPS do telemóvel e a posição do Geo pela rádio (Bluetooth) chegam; o mapa não é preciso.
// Nada sai do telemóvel. "Google Maps" / "Outra app de mapas" só com um toque e depois de avisar quem fica a saber o destino.
"use strict";
const SETA = { MUITO_ANTIGA_MS: 5 * 60 * 1000, PERTO_M: 15, MAPAS_OK: "georede-mapas-aviso" };
const seta = { node: null, eu: null, erroGps: null, rumo: null, fonteRumo: null, rodado: 0, vigia: null, relogio: null,
               trinco: null, ouvinte: null, mapaPedido: null };
const $s = id => document.getElementById(id);

function setaDistancia(a, b) {           // metros (haversine)
  const R = 6371008.8, r = x => x * Math.PI / 180;
  const dLat = r(b.lat - a.lat), dLon = r(b.lon - a.lon);
  const h = Math.sin(dLat / 2) ** 2 + Math.cos(r(a.lat)) * Math.cos(r(b.lat)) * Math.sin(dLon / 2) ** 2;
  return 2 * R * Math.asin(Math.min(1, Math.sqrt(h)));
}
function setaAzimute(a, b) {             // graus a partir do norte, no sentido dos ponteiros
  const r = x => x * Math.PI / 180;
  const y = Math.sin(r(b.lon - a.lon)) * Math.cos(r(b.lat));
  const x = Math.cos(r(a.lat)) * Math.sin(r(b.lat)) - Math.sin(r(a.lat)) * Math.cos(r(b.lat)) * Math.cos(r(b.lon - a.lon));
  return (Math.atan2(y, x) * 180 / Math.PI + 360) % 360;
}
function setaMetros(m) {
  if (m < 100) return `${Math.max(1, Math.round(m / 5) * 5)} m`;
  if (m < 1000) return `${Math.round(m / 10) * 10} m`;
  return `${(m / 1000).toLocaleString(LOCALE, { maximumFractionDigits: m < 10000 ? 1 : 0 })} km`;
}
function setaRumoNome(g) {
  const l = (TEXTOS[LINGUA] && TEXTOS[LINGUA]["seta.rumos"]) || TEXTOS.pt["seta.rumos"];
  return l[Math.round(g / 45) % 8];
}
function setaAparelho() {
  if (seta.node === "encontro") return encontroAlvo();
  return estado.aparelhos.find(x => x.node_id === seta.node) || null;
}

// ---- abrir e fechar
function setaAbrir(node) {
  const a = estado.aparelhos.find(x => x.node_id === node);
  if (!a || !a.ultima) return;
  seta.node = node;
  $s("seta-titulo").textContent = t("seta.titulo", { nome: a.nome });
  $s("seta-confirmar").hidden = true; $s("seta-msg").hidden = true;
  $s("seta-tocar").hidden = SEM_TOCAR.includes(a.perfil) || PERFIS_FIXOS.includes(a.perfil);
  $s("seta").hidden = false;
  setaGps(); setaBussola();
  clearInterval(seta.relogio); seta.relogio = setInterval(setaDesenhar, 1000);
  try { if (navigator.wakeLock) navigator.wakeLock.request("screen").then(l => { seta.trinco = l; }).catch(() => null); } catch (e) { /* nada */ }
