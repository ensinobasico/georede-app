  .lista-mais { margin: 0 16px; padding: 0; border-radius: 14px; background: var(--nevoa); border: 1px solid var(--linha); overflow: hidden; }
  .lista-mais li + li { border-top: 1px solid var(--linha); }
  .lista-mais a { min-height: 58px; padding: 8px 14px; border-radius: 0; gap: 14px; }
  .lista-mais a:hover { background: color-mix(in srgb, var(--tinta) 5%, transparent); }
  .mais-ico { flex: none; width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center;
    color: var(--azul); background: color-mix(in srgb, var(--azul) 13%, transparent); }
  @media (prefers-color-scheme: dark) { .mais-ico { color: var(--foco); } }
  .mais-ico svg, .lista-mais .mais-ico svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; color: inherit; }
  .mais-txt { flex: 1; min-width: 0; display: grid; gap: 1px; font-size: 16px; font-weight: 600; text-align: left; }
  .mais-txt small, .mais-txt .dobra-sub { font-size: 13px; font-weight: 400; color: var(--tinta-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mais-txt small:empty { display: none; }
  svg.chev { flex: none; width: 18px; height: 18px; fill: none; stroke: var(--tinta-2); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  #vista-mais > .cartao.dobravel { margin: 0 16px 8px; padding: 0; border-radius: 14px; background: var(--nevoa); }
  #vista-mais > .cartao[hidden] { display: none; }
  .dobra-cab { width: 100%; display: flex; align-items: center; gap: 12px; min-height: 58px; padding: 8px 14px; cursor: pointer;
    font: inherit; color: var(--tinta); background: none; border: 0; }
  .dobra-cab .mais-txt b { font-size: 16px; margin: 0; }
  .dobra-cab .chev { transition: transform .2s; }
