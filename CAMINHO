  @media (prefers-reduced-motion: reduce) { .procura-cartao .pulso, .marcador.procura::after { animation: none; } }

  /* Telemóvel com a app a ocupar o ecrã todo: os botões + − ficam abaixo da barra de estado */
  .maplibregl-ctrl-top-right, .maplibregl-ctrl-top-left { top: env(safe-area-inset-top); }
  .maplibregl-popup-content { font: 13px/1.4 system-ui, sans-serif; color: #1C2430; border-radius: 8px; }
