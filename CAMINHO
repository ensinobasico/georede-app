  .rep-linhas { display: grid; gap: 4px; font-size: 14px; }
  .rep-linhas .rotulo { color: var(--tinta-2); margin-right: 6px; }
  .rep-grafico { display: grid; gap: 2px; }
  .rep-grafico svg { width: 100%; height: 46px; display: block; }
  .rep-grafico polyline { fill: none; stroke: var(--verde); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .rep-grafico line { stroke: var(--linha); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .rep-grafico small, .rep-nota { font-size: 12px; color: var(--tinta-2); }
  .rep-nota { margin: 0; }
  .rep-cartao .botao { justify-self: start; }
  /* Cobertura (12/11/2026): barra por cima do painel do mapa e página em Mais */
  .cob-barra { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 0 18px 10px; font-size: 13px; color: var(--tinta-2); }
  .cob-barra .texto { flex: 1 1 100%; min-width: 0; }
  .cob-barra button { font: inherit; padding: 6px 12px; border: 1px solid var(--linha); border-radius: 999px; background: var(--nevoa); color: var(--tinta); cursor: pointer; }
  .cob-barra button[aria-pressed="true"] { background: var(--azul); border-color: var(--azul); color: #fff; }
  .cob-barra #cob-esconder { margin-left: auto; }
  .cob-partilha { margin: 6px 18px 10px; padding: 4px 14px 10px; border: 1px solid var(--linha); border-radius: 12px; }
  .cob-partilha .rotulo-secao { margin: 0; }
  /* Comunidade à volta (12/11/2026): contagens anónimas por Farol */
  .rep-secao { margin: 8px 18px 8px; font-size: 13px; font-weight: 700; color: var(--tinta-2); }
  .rep-numero { font-size: 26px; font-weight: 700; line-height: 1.15; overflow-wrap: anywhere; }
  .rep-barras { display: flex; align-items: flex-end; gap: 2px; height: 46px; border-bottom: 1px solid var(--linha); min-width: 0; }
  .rep-barras span { flex: 1 1 0; min-width: 0; background: var(--verde); border-radius: 2px 2px 0 0; }
  .info-caixa { margin: 4px 16px 14px; padding: 12px 14px; border-radius: 12px; background: var(--nevoa); border: 1px solid var(--linha); font-size: 14px; color: var(--tinta-2); }
