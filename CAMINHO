    background: var(--painel); border: 1px solid var(--linha); border-radius: 14px; box-shadow: 0 8px 24px rgba(0,0,0,.18); }
  .voz-linguas b { padding: 6px 10px 4px; font-size: 12.5px; font-weight: 600; color: var(--tinta-2); }
