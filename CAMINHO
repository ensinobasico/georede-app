window.addEventListener("online", () => { document.getElementById("aviso").hidden = true; atualizar(); });
if (!navigator.onLine) setTimeout(() => mostrarErro(new TypeError("sem internet")), 0);

async function atualizar() {
  if (window.georedeEmergencia) return;                                  // sem conta: nada do servidor
  try {
    if (!estado.conta) { estado.conta = await obter("/api/eu"); try { localStorage.removeItem("georede-saiu"); const s = document.getElementById("saiu"); if (s) s.remove(); } catch (e) { /* nada */ } mostrarConta(); pedirGuardarApp(); radioContaConfirmada(estado.conta.email); }

    estado.ultimaAtualizacao = Date.now();
    const r = await obter("/api/dispositivos");
