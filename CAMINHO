// ---- guardar um ficheiro (GPX, os teus dados): no browser descarrega; na app Android abre o «Partilhar» do Android
// (plugin nativo GeoredeFicheiro). Devolve "descarregado" | "partilhado" | "sem_suporte".
function ficheiroNativo() {
  if (!/GEOREDE-Android/.test(navigator.userAgent || "")) return null;
  const C = window.Capacitor;
  return (C && C.Plugins && C.Plugins.GeoredeFicheiro) || false;
