    color: var(--azul); background: none; border: 1.5px solid var(--azul); border-radius: 10px; }
  @media (prefers-color-scheme: dark) { .encontro-convidar button { color: var(--foco); border-color: var(--foco); } }
  section.seta .encontro-estado { margin: 6px 0 0; font-size: 14px; font-weight: 600; color: var(--azul); text-align: center; }
  section.seta .encontro-estado[hidden] { display: none; }
