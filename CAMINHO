const FAROL_OUVIR_MIN = 30;          // o Farol manda leituras de 10 em 10 min: 30 min sem nada = não está a ouvir
function textoFarol(a) {
  const h = vistoEm(a);
  if (!h) return t("farol.estado_espera");
  return Date.now() - new Date(h).getTime() < FAROL_OUVIR_MIN * 60000
    ? t("farol.estado_ouvir", { quando: quando(h) }) : t("farol.estado_parado", { quando: quando(h) });
}
