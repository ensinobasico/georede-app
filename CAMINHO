  c.append(p(t("achado.explica")));
  const img = document.createElement("img"); img.id = "achado-qr"; img.alt = D.url; img.width = 220; img.height = 220;
  img.src = "/api/achados/qr.svg?node_id=" + D.node_id + "&c=" + D.codigo;
  img.style.cssText = "display:block;margin:0 auto;background:#fff;border-radius:12px;padding:6px" + (D.ativo ? "" : ";opacity:.35");
  const u = p(D.url, "dica"); u.style.cssText = "text-align:center;word-break:break-all"; u.id = "achado-url";
  const ligacoes = document.createElement("div"); ligacoes.className = "botoes";
  const desc = document.createElement("a"); desc.href = img.src; desc.download = "georede-qr-" + (achado.a.nome || "geo") + ".svg";
  desc.textContent = t("achado.descarregar"); desc.className = "botao-link";
  const ver = document.createElement("a"); ver.href = D.url; ver.target = "_blank"; ver.rel = "noopener"; ver.textContent = t("achado.ver"); ver.className = "botao-link";
  ligacoes.append(desc, ver);
  const caixa = (id, texto, valor) => {
    const l = document.createElement("label"); l.style.cssText = "display:flex;gap:10px;align-items:flex-start";
    const i = document.createElement("input"); i.type = "checkbox"; i.id = id; i.checked = !!valor; i.style.marginTop = "4px";
    l.append(i, document.createTextNode(texto)); return l;
  };
  const tel = document.createElement("label"); tel.className = "campo";
  const ti = document.createElement("input"); ti.type = "text"; ti.inputMode = "tel"; ti.id = "achado-telefone"; ti.autocomplete = "tel";
