    n.visto = Date.now(); n.vivo = true;
    if (p.hop_start && p.hop_start >= (p.hop_limit || 0)) n.saltos = p.hop_start - (p.hop_limit || 0);
    if (p.payload_variant === "decoded" && p.decoded && p.decoded.portnum === RADIO.PORTA.POSICAO) {
      const x = GeoProto.descodificar("Position", p.decoded.payload || new Uint8Array());
      if (x.latitude_i != null && x.longitude_i != null && (x.latitude_i || x.longitude_i)) { n.latI = x.latitude_i; n.lonI = x.longitude_i; n.bits = x.precision_bits || 0; }
    }
  } catch (e) { /* nada */ }
}
// O que o Geo ligado entregou, em números, para se perceber uma contagem que pareça baixa
function cobDiagnostico(agora, meuNum, meus) {
  const d = { total: 0, recentes: 0, antigos: 0, sem_hora: 0, mqtt: 0, mqtt_recentes: 0, da_rede: 0, pos: 0, vivo: 0 };
  for (const [num, x] of cob.lista) {
    if (num === meuNum) continue;
    if (meus.has(num)) { d.da_rede++; continue; }
    d.total++;
    if (x.pos) d.pos++;
    if (x.mqtt) { d.mqtt++; if (x.hora > 1.6e9 && agora - x.hora * 1000 <= COB.JANELA_MS) d.mqtt_recentes++; }
    else if (!(x.hora > 1.6e9)) d.sem_hora++;
    else if (agora - x.hora * 1000 > COB.JANELA_MS) d.antigos++;
    else d.recentes++;
  }
  for (const [num, n] of cob.nos) if (n.vivo && num !== meuNum && !meus.has(num)) d.vivo++;
  return d;
}
// O retrato a enviar. `meus`: os Geos da própria rede (não são «equipamentos de fora»)
function cobRetrato(agora, meuNum, meus, minhaPosicao) {
  const lista = [];
  for (const [num, n] of cob.nos) {
    if (num === meuNum || meus.has(num)) continue;
    if (!n.visto || agora - n.visto > COB.JANELA_MS || n.visto - agora > 600000) continue;
    const nivel = cobNivel(n.latI, n.lonI, n.bits);
    const c = nivel ? cobCelula(n.latI, n.lonI, nivel) : [0, 0];
    lista.push({ visto: n.visto, v: [num, nivel, c[0], c[1], n.saltos == null ? null : Math.min(7, Math.max(0, n.saltos))] });
  }
  lista.sort((a, b) => b.visto - a.visto);
  let rx = null;
  if (minhaPosicao && agora - new Date(minhaPosicao.hora).getTime() < COB.POSICAO_MS)
    rx = cobCelula(Math.round(minhaPosicao.lat * 1e7), Math.round(minhaPosicao.lon * 1e7), 1);
  return { geo: meuNum, rx, nos: lista.slice(0, COB.NOS_MAX).map(x => x.v) };
}
function cobMinhaPosicao() {
  if (!radio.meu) return null;
  const doGeo = (radio.nos.get(radio.meu.num) || {}).ultima;
  const a = estado.aparelhos.find(x => x.node_id === radio.meu.num);
  // a posição que o servidor tem de um repetidor é a que ele mostra à comunidade, aproximada de propósito (~3 km)
  const doServidor = a && !a.repetidor && !a.sintetico ? a.ultima : null;
  const candidatos = [doGeo, doServidor].filter(u => u && u.lat != null && u.lon != null && u.hora
    && cobNivel(Math.round(u.lat * 1e7), Math.round(u.lon * 1e7), 0) === 1);
  candidatos.sort((a, b) => new Date(b.hora) - new Date(a.hora));
  return candidatos[0] || null;
}
function cobMeus() { return new Set(estado.aparelhos.filter(a => !a.sintetico).map(a => a.node_id)); }
function cobAgendar(ms) {
  clearTimeout(cob.temporizador);
  cob.temporizador = setTimeout(() => { cobEnviar().finally(() => { if (radioAtivo()) cobAgendar(COB.INTERVALO_MS); }); }, ms);
}
async function cobEnviar() {
  if (cob.aEnviar || !radioAtivo() || !radio.meu || !navigator.onLine) return null;
  if (!estado.conta || !estado.conta.cliente_id || window.georedeEmergencia) return null;
  if (cobEstado.dados && cobEstado.dados.partilha === false) return null;                 // a pessoa desligou a partilha
  cob.aEnviar = true;
  try {
    const meus = cobMeus();
    if (!meus.has(radio.meu.num)) return null;                                             // Geo que não é da conta
    const r = await enviar("/api/cobertura", cobRetrato(Date.now(), radio.meu.num, meus, cobMinhaPosicao()));
    cob.resultado = r.corpo || null;
    if (r.ok && r.corpo && r.corpo.ok) cob.enviado = new Date().toISOString();
    if (r.ok && r.corpo && r.corpo.motivo === "desligada" && cobEstado.dados) cobEstado.dados.partilha = false;
    return r.corpo;
  } catch (e) { return null; }
  finally { cob.aEnviar = false; }
}

// ---- no mapa
const COB_COR = { e: "#2E9E6B", r: "#1E5BB8", vazio: "#8A94A6" };
function cobOpacidade(n, nivel) { const o = n >= 16 ? 0.5 : n >= 6 ? 0.36 : 0.22; return nivel === 3 ? o * 0.6 : o; }
function cobPoligono(nivel, i, j) {
  const pa = COB.PASSO_LAT * nivel, po = COB.PASSO_LON * nivel;
  const s = i * pa, n = (i + 1) * pa, o = j * po, e = (j + 1) * po;
  return [[[o, s], [e, s], [e, n], [o, n], [o, s]]];
}
function cobCelulas(tipo) { return ((cobEstado.dados && cobEstado.dados.celulas) || []).filter(c => c[0] === tipo); }
function desenharCoberturaMapa() {
  const f = typeof mapa !== "undefined" && mapa.getSource && mapa.getSource("cobertura");
  const barra = document.getElementById("cob-barra");
  barra.hidden = !cobEstado.noMapa;
  if (cobEstado.noMapa) {
    const n = cobCelulas(cobEstado.tipo).filter(c => c[4] > 0).length;
    document.getElementById("cob-barra-texto").textContent = t(cobEstado.tipo === "e" ? "cob.barra_e" : "cob.barra_r", { n });
    barra.querySelectorAll("button[data-cob]").forEach(b => b.setAttribute("aria-pressed", String(b.dataset.cob === cobEstado.tipo)));
  }
  if (!f) return;
  // os de 3 km primeiro, para os de 1 km ficarem por cima
  const celulas = cobEstado.noMapa ? cobCelulas(cobEstado.tipo).slice().sort((a, b) => b[1] - a[1]) : [];
  f.setData({ type: "FeatureCollection", features: celulas.map(c => ({ type: "Feature",
    geometry: { type: "Polygon", coordinates: cobPoligono(c[1], c[2], c[3]) },
    properties: { tipo: c[0], nivel: c[1], nos: c[4], diretos: c[5], cor: c[4] ? COB_COR[c[0]] : COB_COR.vazio, opacidade: cobOpacidade(c[4], c[1]) } })) });
}
let cobPopupAberto = null;
function cobPopup(lngLat, p) {
  if (cobPopupAberto) cobPopupAberto.remove();
  const texto = p.tipo === "e" ? t("cob.popup_e", { n: p.nos }) + " · " + t("rep.com.diretos", { n: p.diretos })
                               : Number(p.nos) ? t("cob.popup_r", { n: p.nos }) : t("cob.popup_r0");
  cobPopupAberto = new maplibregl.Popup({ closeButton: false }).setLngLat(lngLat)
    .setText(texto + " · " + t(Number(p.nivel) === 3 ? "cob.quadrado_3" : "cob.quadrado_1")).addTo(mapa);
}
function cobVerNoMapa(tipo) {
  cobEstado.noMapa = true; cobEstado.tipo = tipo || cobEstado.tipo;
  if (!cobCelulas(cobEstado.tipo).length && cobCelulas(cobEstado.tipo === "e" ? "r" : "e").length) cobEstado.tipo = cobEstado.tipo === "e" ? "r" : "e";
  mudarVista("mapa");
  desenharCoberturaMapa();
  const cs = cobCelulas(cobEstado.tipo);
  if (!cs.length) return;
  const b = new maplibregl.LngLatBounds();
  for (const c of cs) { const anel = cobPoligono(c[1], c[2], c[3])[0]; b.extend(anel[0]); b.extend(anel[2]); }
  try { mapa.fitBounds(b, { padding: margens(), maxZoom: 13 }); } catch (e) { /* mapa ainda a carregar */ }
}
document.getElementById("cob-esconder").addEventListener("click", () => {
